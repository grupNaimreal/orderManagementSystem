@model orderManagementSystem.Models.ProductOptionFormViewModel 
@{ ViewData["Title"] = "Edit Product Option"; } 
<h1>Edit Variant / Add-on</h1> 
<form asp-action="EditOption" method="post"> 
    <input asp-for="Id" type="hidden" /><input asp-for="ProductId" type="hidden" /> 
    <div asp-validation-summary="ModelOnly" class="text-danger"></div> 
    <div class="mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div> 
    <div class="mb-3"><label asp-for="OptionType"></label><select asp-for="OptionType" class="form-select"><option>Variant</option><option>AddOn</option></select><span asp-validation-for="OptionType" class="text-danger"></span></div> 
    <div class="mb-3"><label asp-for="PriceAdjustment"></label><input asp-for="PriceAdjustment" type="number" step="0.01" class="form-control" /><span asp-validation-for="PriceAdjustment" class="text-danger"></span></div> 
    <div class="form-check mb-3"><input asp-for="IsAvailable" class="form-check-input" /><label asp-for="IsAvailable">Available</label></div> 
    <button class="btn btn-primary" type="submit">Save</button><a asp-controller="Products" asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-secondary">Cancel</a> 
</form> 
@section Scripts { <partial name="_ValidationScriptsPartial" /> } 