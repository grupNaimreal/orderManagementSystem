@model orderManagementSystem.Models.Product 
@{ ViewData["Title"] = "Product Details"; } 

<h1>@Model.Name</h1> 
<dl class="row"> 
    <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category?.Name</dd> 
    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd> 
    <dt class="col-sm-3">Price</dt><dd class="col-sm-9">@Model.Price.ToString("N2")</dd> 
    <dt class="col-sm-3">Availability</dt><dd class="col-sm-9">@(Model.IsAvailable ? "Available" : "Unavailable")</dd> 
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) 
    { 
        <dt class="col-sm-3">Image</dt><dd class="col-sm-9"><img src="@Model.ImageUrl" alt="@Model.Name" style="max-width:240px;max-height:180px" /></dd> 
    } 
</dl> 
<h2>Variants and Add-ons</h2> 
<table class="table table-striped"> 
    <thead><tr><th>Name</th><th>Type</th><th>Price Adjustment</th><th>Available</th><th></th></tr></thead> 
    <tbody> 
    @foreach (var option in Model.Options.OrderBy(o => o.OptionType).ThenBy(o => o.Name)) 
    { 
        <tr><td>@option.Name</td><td>@option.OptionType</td><td>@option.PriceAdjustment.ToString("N2")</td><td>@(option.IsAvailable ? "Yes" : "No")</td> 
            <td> 
                @if (User.IsInRole("Owner")) 
                { 
                    <a asp-action="EditOption" asp-route-id="@option.Id">Edit</a> 
                    <form asp-action="DeleteOption" asp-route-id="@option.Id" method="post" class="d-inline"><button class="btn btn-link p-0" type="submit">Delete</button></form> 
                } 
            </td> 
        </tr> 
    } 
    </tbody> 
</table> 
@if (User.IsInRole("Owner")) 
{ 
    <h3>Add Variant / Add-on</h3> 
    @if (TempData["OptionError"] != null) { <p class="text-danger">@TempData["OptionError"]</p> } 
    <form asp-action="AddOption" method="post"> 
        <input type="hidden" name="ProductId" value="@Model.Id" /> 
        <div class="mb-2"><label for="optionName">Name</label><input id="optionName" name="Name" class="form-control" required maxlength="80" /></div> 
        <div class="mb-2"><label for="optionType">Type</label><select id="optionType" name="OptionType" class="form-select"><option>Variant</option><option>AddOn</option></select></div> 
        <div class="mb-2"><label for="priceAdjustment">Price adjustment</label><input id="priceAdjustment" name="PriceAdjustment" type="number" step="0.01" value="0" class="form-control" /></div> 
        <div class="form-check mb-3"><input id="optionAvailable" name="IsAvailable" type="checkbox" value="true" checked class="form-check-input" /><input name="IsAvailable" type="hidden" value="false" /><label for="optionAvailable">Available</label></div> 
        <button class="btn btn-primary" type="submit">Add Option</button> 
    </form> 
} 
@if (User.IsInRole("Owner") || User.IsInRole("Employee")) 
{ 
    <form asp-action="SetAvailability" method="post" class="mt-3"> 
        <input type="hidden" name="id" value="@Model.Id" /> 
        <input type="hidden" name="isAvailable" value="@(!Model.IsAvailable)" /> 
        <button class="btn btn-outline-primary" type="submit">Mark @(Model.IsAvailable ? "Unavailable" : "Available")</button> 
    </form> 
} 
@if (User.IsInRole("Owner")) { <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary mt-3">Edit Product</a> } 
<a asp-action="Index" class="btn btn-secondary mt-3">Back to Products</a> 