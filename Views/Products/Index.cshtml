@*
    Views/Products/Index.cshtml
    Menu Studio (PC Owner/Staff) & Digital Menu (Mobile Customer) for QRDER (Bean Crate Cafe):
    - Orders both categories and products in the exact 11-page Bean Crate Cafe menu sequence.
    - Displays 17 distinct bespoke SVG category icons tailored to each menu section.
    - Preserves the live AJAX search endpoint (@Url.Action("Search")) into #productGrid.
*@
@using Microsoft.AspNetCore.Html
@model IEnumerable<orderManagementSystem.Models.Product>

@{
    var isOwner = User.IsInRole("Owner");
    var isStaff = isOwner || User.IsInRole("Employee");
    ViewData["Title"] = isStaff ? "Menu Studio" : "Menu";

    var productsList = Model.ToList();
    var totalProducts = productsList.Count;
    var availableProducts = productsList.Count(p => p.IsAvailable);
    var unavailableProducts = productsList.Count(p => !p.IsAvailable);
    var categoryCount = productsList
        .Where(p => p.Category != null && !string.IsNullOrWhiteSpace(p.Category.Name))
        .Select(p => p.Category!.Name.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
}

<style>
    .menu-search {
        max-width: 520px;
    }

    .category-pick-card {
        border: 1px solid var(--qrder-border);
        border-radius: 16px;
        background: var(--qrder-surface);
        padding: 1.35rem 1rem;
        text-align: center;
        cursor: pointer;
        transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
        height: 100%;
    }

    .category-pick-card:hover {
        transform: translateY(-3px);
        border-color: var(--qrder-espresso);
        box-shadow: 0 8px 20px rgba(54, 36, 28, .10);
    }

    .category-pick-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background-color: var(--qrder-cream-soft);
        border: 1px solid var(--qrder-border);
        color: #4A1C05;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.75rem;
    }

    .category-pick-icon svg {
        width: 30px;
        height: 30px;
    }

    .product-card {
        height: 100%;
        border: 1px solid var(--qrder-border);
        border-radius: 14px;
        overflow: hidden;
        background: var(--qrder-surface);
        transition: transform .18s ease, box-shadow .18s ease;
    }

    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 22px rgba(54, 36, 28, .10);
    }

    .product-image-square {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: var(--qrder-cream-soft);
    }

    .product-image {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        max-width: none;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .product-placeholder {
        width: 100%;
        height: 100%;
        background: var(--qrder-cream-soft);
        color: var(--qrder-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .9rem;
    }

    .product-name {
        color: var(--qrder-ink);
        font-weight: 700;
    }

    .product-price {
        color: var(--qrder-ink);
        font-weight: 700;
        font-size: 1.1rem;
    }

    .qrder-cart-sticky-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1035;
        background-color: var(--qrder-espresso);
        color: #f6efe6;
        padding: 0.75rem 1rem;
        box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.18);
    }

    .qrder-cart-sticky-inner {
        max-width: 1140px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
    }

    @@media (hover: none) {
        .product-card:hover,
        .category-pick-card:hover {
            transform: none;
            box-shadow: none;
        }
    }
</style>

@if (isStaff)
{
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <div class="qrder-eyebrow"><span class="qrder-wordmark-inline">QRDER</span> &middot; BEAN CRATE CAFE</div>
            <h1 class="qrder-page-title">Menu Studio</h1>
            <p class="qrder-page-subtitle mb-0">
                @(isOwner
                    ? "Manage Bean Crate Cafe drinks, meals, pricing, options, and item availability."
                    : "Browse available Bean Crate Cafe items, prices, and customization options.")
            </p>
        </div>

        @if (isOwner)
        {
            <div>
                <a asp-action="Create" class="btn menu-btn px-4 py-2 fw-semibold">
                    + Add Product
                </a>
            </div>
        }
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3">
            <div class="qrder-callout">
                <div class="small text-muted">Total Menu Items</div>
                <div class="fs-4 fw-bold mt-1">@totalProducts</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="qrder-callout">
                <div class="small text-muted">Available Now</div>
                <div class="fs-4 fw-bold mt-1">@availableProducts</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="qrder-callout">
                <div class="small text-muted">Unavailable / Sold Out</div>
                <div class="fs-4 fw-bold mt-1">@unavailableProducts</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="qrder-callout">
                <div class="small text-muted">Categories</div>
                <div class="fs-4 fw-bold mt-1">@categoryCount</div>
            </div>
        </div>
    </div>

    <div class="qrder-card mb-4">
        <div class="menu-search">
            <label for="productSearch" class="visually-hidden">Search menu items</label>
            <input id="productSearch"
                   class="form-control"
                   type="search"
                   placeholder="Search drinks, meals, and more..."
                   data-url="@Url.Action("Search")" />
        </div>
    </div>

    <div class="row g-4" id="productGrid">
        <partial name="_ProductRows" model="Model" />
    </div>
}
else
{
    var categories = productsList
        .GroupBy(p => string.IsNullOrWhiteSpace(p.Category?.Name) ? "Other" : p.Category!.Name.Trim())
        .Select(g => new
        {
            Name = g.Key,
            Count = g.Count(),
            SortOrder = orderManagementSystem.Data.MenuSeeder.GetCategorySortOrder(g.Key)
        })
        .OrderBy(c => c.SortOrder)
        .ThenBy(c => c.Name)
        .ToList();

    IHtmlContent RenderCategorySvg(string name)
    {
        var key = name.Trim().ToLowerInvariant();
        string inner = key switch
        {
            "coffee" => "<path d='M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V9z'/><path d='M16 10h2a2 2 0 0 1 0 4h-2'/><path d='M8 4c0 1.5 1 2 1 3M12 4c0 1.5 1 2 1 3' stroke='#C05800'/>",
            "non-coffee" => "<path d='M7 7h10l-1 13H8L7 7z'/><path d='M6 7h12'/><path d='M14 3l-2 4' stroke='#C05800'/><path d='M7.5 13h9' stroke='#C05800'/>",
            "pasta" => "<path d='M4 13h16a8 8 0 0 1-16 0z'/><path d='M6 10c2-2 4 2 6 0s4 2 6 0' stroke='#C05800'/><path d='M5 6h14'/>",
            "sandwiches" => "<path d='M4 10a8 5 0 0 1 16 0H4z'/><path d='M3 13h18' stroke='#C05800' stroke-width='2.2'/><path d='M5 16h14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z'/>",
            "snacks" => "<path d='M6 10h12l-1.5 10h-9L6 10z'/><path d='M8 10V5M11 10V4M14 10V5M16 10V6' stroke='#C05800'/>",
            "juices & lemonades" => "<path d='M7 8h10l-1.2 12H8.2L7 8z'/><circle cx='16' cy='7' r='3.5' stroke='#C05800'/><path d='M10 4l1.5 4'/>",
            "house blend" => "<path d='M7 6h9l-1 14H8L7 6z'/><path d='M16 9h2a2 2 0 0 1 0 5h-2'/><path d='M11 11c2-2 4 0 3 2s-3 2-3 0z' stroke='#C05800'/>",
            "lemon soda" => "<path d='M7 7h10l-1 13H8L7 7z'/><circle cx='11' cy='12' r='1' fill='#C05800'/><circle cx='14' cy='15' r='1.2' fill='#C05800'/><circle cx='10' cy='16' r='0.9' fill='#C05800'/><path d='M15 3l-2 4' stroke='#C05800'/>",
            "thai series & floats" => "<path d='M7 10h10l-1 10H8L7 10z'/><path d='M8 10a4 4 0 0 1 8 0' stroke='#C05800'/><path d='M15 4l-2 5' stroke='#C05800'/>",
            "parfait series" => "<path d='M7 9h10l-2 9H9L7 9z'/><path d='M9 20h6M12 18v2'/><path d='M8 9a4 3.5 0 0 1 8 0' stroke='#C05800'/><circle cx='12' cy='4.5' r='1.3' fill='#C05800'/>",
            "specialty drinks" => "<path d='M7 9h10l-1 11H8L7 9z'/><path d='M6 7l3-3 3 2.5L15 4l3 3' stroke='#C05800'/>",
            "desserts & banana pudding" => "<path d='M5 13h14l-1.5 6h-11L5 13z'/><path d='M7 13a5 4 0 0 1 10 0' stroke='#C05800'/><circle cx='12' cy='7.5' r='1.3' fill='#C05800'/>",
            "buldak series" => "<path d='M4 12h16a8 7 0 0 1-16 0z'/><path d='M5 7l14-2M5 9l14-1' stroke='#C05800'/><path d='M12 15c1.5-1.5 1.5-3 0-4-1.5 1-1.5 2.5 0 4z' fill='#C05800'/>",
            "matcha foam series" => "<path d='M7 7h10l-1 13H8L7 7z'/><path d='M7.3 10.5h9.4' stroke='#C05800' stroke-width='2.4'/><path d='M14 3l-1.5 4'/>",
            "ube series" => "<path d='M7 7h10l-1 13H8L7 7z'/><path d='M8 15c2-1.5 2 1.5 4 0s2 1.5 4 0' stroke='#C05800'/><path d='M14 3l-1.5 4'/>",
            "pistachio series" => "<path d='M7 8h10l-1 12H8L7 8z'/><ellipse cx='12' cy='5' rx='3' ry='1.8' stroke='#C05800'/><path d='M7.4 11h9.2' stroke='#C05800'/>",
            "rice bowls" => "<path d='M4 12h16a8 7 0 0 1-16 0z'/><path d='M6 12a6 4 0 0 1 12 0' stroke='#C05800'/><path d='M8 20h8'/>",
            _ => "<path d='M7 7h10l-1 13H8L7 7z'/><path d='M14 3l-2 4' stroke='#C05800'/>"
        };

        return new HtmlString($"<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\">{inner}</svg>");
    }

    <div class="mb-3">
        <div class="qrder-eyebrow"><span class="qrder-wordmark-inline">QRDER</span> &middot; BEAN CRATE CAFE</div>
        <h1 class="h3 fw-bold mb-1">Our Menu</h1>
        <p class="text-muted small mb-0">Choose a category below to browse items and add them to your order.</p>
    </div>

    @if (TempData["AddedToOrderNotice"] is string addedNotice)
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between py-2 px-3 mb-3" role="status">
            <span class="small fw-semibold">&#10003; @addedNotice</span>
            <a asp-controller="Orders" asp-action="Create" class="btn btn-sm btn-success fw-semibold">
                Checkout
            </a>
        </div>
    }

    <div class="qrder-card mb-4">
        <div class="menu-search w-100" style="max-width: 100%;">
            <label for="productSearch" class="visually-hidden">Search menu items</label>
            <input id="productSearch"
                   class="form-control"
                   type="search"
                   placeholder="Search all drinks, meals, and desserts..."
                   data-url="@Url.Action("Search")" />
        </div>
    </div>

    @* Step 1: Category & Icon Picker (ordered by Bean Crate Cafe's 11-page menu) *@
    <div id="categoryPickerSection" class="mb-4">
        <div class="small text-muted fw-semibold text-uppercase mb-2" style="letter-spacing: 0.08em;">
            Select a Category
        </div>
        <div class="row g-3">
            @foreach (var cat in categories)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <button type="button"
                            class="category-pick-card w-100 border-1"
                            data-pick-category="@cat.Name">
                        <div class="category-pick-icon">@RenderCategorySvg(cat.Name)</div>
                        <div class="fw-bold text-dark">@cat.Name</div>
                        <div class="small text-muted mt-1">@cat.Count item(s)</div>
                    </button>
                </div>
            }
        </div>
    </div>

    @* Step 2: Filtered Product Grid (hidden until a category is chosen or a search is typed) *@
    <div id="categoryProductsSection" class="d-none">
        <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
            <button type="button" id="backToCategoriesBtn" class="btn btn-sm btn-outline-secondary px-3">
                &larr; All Categories
            </button>
            <span class="fw-bold" id="activeCategoryHeading"></span>
        </div>

        <div class="row g-4" id="productGrid">
            <partial name="_ProductRows" model="Model" />
        </div>
    </div>

    @* Sticky Bottom Order Cart Bar (clickable to proceed to checkout) *@
    <a id="qrderCartFooter"
       asp-controller="Orders"
       asp-action="Create"
       class="qrder-cart-sticky-bar text-decoration-none d-none">
        <div class="qrder-cart-sticky-inner">
            <div class="d-flex align-items-center gap-2">
                <span class="badge rounded-pill"
                      id="qrderCartCountBadge"
                      style="background-color: #ede0c9; color: #2b1d16; font-size: 0.85rem;">
                    0
                </span>
                <span class="fw-semibold small" id="qrderCartLabel">items in your order</span>
            </div>
            <span class="btn btn-sm fw-bold px-3"
                  style="background-color: #ede0c9; color: #2b1d16; border-radius: 999px;">
                Proceed to Checkout &rarr;
            </span>
        </div>
    </a>
}

@section Scripts {
    <script>
        (() => {
            const input = document.getElementById('productSearch');
            const grid = document.getElementById('productGrid');
            const categoryPicker = document.getElementById('categoryPickerSection');
            const categoryProducts = document.getElementById('categoryProductsSection');
            const backBtn = document.getElementById('backToCategoriesBtn');
            const headingEl = document.getElementById('activeCategoryHeading');
            const isCustomerView = Boolean(categoryPicker && categoryProducts);

            let selectedCategory = null;
            let timer;
            let request;

            function filterGridByCategory(categoryName) {
                if (!grid) return;
                const cards = grid.querySelectorAll('[data-product-col]');
                cards.forEach(col => {
                    const itemCat = col.getAttribute('data-category') || 'Other';
                    const show = !categoryName || itemCat.toLowerCase() === categoryName.toLowerCase();
                    col.classList.toggle('d-none', !show);
                });
            }

            function openCategory(categoryName) {
                selectedCategory = categoryName;
                if (headingEl) headingEl.textContent = categoryName;
                filterGridByCategory(categoryName);
                categoryPicker?.classList.add('d-none');
                categoryProducts?.classList.remove('d-none');
            }

            function showAllCategories() {
                selectedCategory = null;
                if (input) input.value = '';
                categoryProducts?.classList.add('d-none');
                categoryPicker?.classList.remove('d-none');
            }

            document.querySelectorAll('[data-pick-category]').forEach(btn => {
                btn.addEventListener('click', () => {
                    openCategory(btn.getAttribute('data-pick-category'));
                });
            });

            backBtn?.addEventListener('click', showAllCategories);

            // Sync sticky checkout footer with session cart
            function refreshStickyCartBar() {
                const bar = document.getElementById('qrderCartFooter');
                const badge = document.getElementById('qrderCartCountBadge');
                const label = document.getElementById('qrderCartLabel');
                if (!bar || !badge || !label) return;

                try {
                    const raw = sessionStorage.getItem('qrder_customer_cart');
                    const items = raw ? JSON.parse(raw) : [];
                    const totalQty = Array.isArray(items)
                        ? items.reduce((sum, item) => sum + (Number(item.Quantity) || 1), 0)
                        : 0;

                    if (totalQty > 0) {
                        badge.textContent = String(totalQty);
                        label.textContent = totalQty === 1 ? '1 item in your order' : `${totalQty} items in your order`;
                        bar.classList.remove('d-none');
                        document.body.style.paddingBottom = '64px';
                    } else {
                        bar.classList.add('d-none');
                    }
                } catch {
                    bar.classList.add('d-none');
                }
            }

            refreshStickyCartBar();

            if (!input || !grid) {
                return;
            }

            input.addEventListener('input', () => {
                clearTimeout(timer);

                timer = setTimeout(async () => {
                    const term = input.value.trim();

                    if (isCustomerView && term.length === 0) {
                        if (selectedCategory) {
                            openCategory(selectedCategory);
                        } else {
                            showAllCategories();
                        }
                        return;
                    }

                    request?.abort();
                    request = new AbortController();

                    try {
                        const response = await fetch(
                            input.dataset.url + '?term=' + encodeURIComponent(term),
                            { signal: request.signal }
                        );

                        if (response.ok) {
                            grid.innerHTML = await response.text();
                            if (isCustomerView) {
                                if (headingEl) headingEl.textContent = `Search results for "${term}"`;
                                categoryPicker?.classList.add('d-none');
                                categoryProducts?.classList.remove('d-none');
                            }
                        }
                    } catch (error) {
                        if (error.name !== 'AbortError') {
                            console.error(error);
                        }
                    }
                }, 250);
            });
        })();
    </script>
}