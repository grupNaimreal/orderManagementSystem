@*
    Views/Shared/_Layout.cshtml
    Shared application shell for QRDER (Bean Crate Cafe):
    - Loads full Source Serif 4 font weights (400-800 + italics) for unified editorial typography.
    - Owner / Employee (PC & Tablet Landscape POS Workspace): Docked left dark-brown sidebar with
      permanently emphasized "+ New Order" action, upgraded Log Out button, and fluid cream workspace.
    - Customer / Unauthenticated (Mobile-Priority, Tablet Landscape & PC-Adaptive): Clean dark-espresso
      top bar locked to Light Mode with QRDER logo, Admin/Staff Login, and brand social icons.
*@
@{
    var isOwner = User.IsInRole("Owner");
    var isEmployee = User.IsInRole("Employee");
    var isStaff = isOwner || isEmployee;

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    bool IsActive(string controller, string? action = null)
    {
        var controllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);
        if (!controllerMatch)
        {
            return false;
        }

        return string.IsNullOrEmpty(action)
            || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
    }

    var bodyClass = isStaff ? "qrder-pos-body" : "qrder-mobile-body";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QRDER</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;0,8..60,800;1,8..60,400;1,8..60,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/orderManagementSystem.styles.css" asp-append-version="true" />
    <style>
        /* Permanent Roastery Press emphasis for + New Order in the staff POS sidebar */
        .qrder-sidebar-nav .qrder-nav-item-featured {
            background-color: #C05800;
            border: 2px solid #f6efe6;
            color: #fffaf3 !important;
            font-weight: 800;
            box-shadow: 3px 3px 0px #000000;
            margin-top: 0.25rem;
            margin-bottom: 0.4rem;
        }

        .qrder-sidebar-nav .qrder-nav-item-featured .qrder-featured-plus {
            width: 22px;
            height: 22px;
            border-radius: 2px;
            background-color: #ede0c9;
            color: #2b1d16;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 0.95rem;
            line-height: 1;
            flex-shrink: 0;
        }

        .qrder-sidebar-nav .qrder-nav-item-featured:hover,
        .qrder-sidebar-nav .qrder-nav-item-featured.active {
            background: #ede0c9 !important;
            border-color: #f6efe6 !important;
            color: #2b1d16 !important;
            box-shadow: 3px 3px 0px #000000;
        }

        .qrder-sidebar-nav .qrder-nav-item-featured:hover .qrder-featured-plus,
        .qrder-sidebar-nav .qrder-nav-item-featured.active .qrder-featured-plus {
            background-color: #4A1C05;
            color: #fff8ef;
        }

        /* Upgraded Staff Sidebar Account & Logout Styling */
        .qrder-sidebar-account .qrder-account-list {
            list-style: none;
            margin: 0 0 0.65rem 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 0.45rem;
        }

        .qrder-sidebar-account .qrder-account-user-link {
            display: block;
            padding: 0.42rem 0.65rem;
            border-radius: var(--qrder-radius, 4px);
            background-color: rgba(255, 255, 255, 0.08);
            border: 1.5px solid rgba(237, 224, 201, 0.35);
            color: #f6efe6 !important;
            font-size: 0.78rem;
            font-weight: 700;
            text-decoration: none !important;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            text-align: center;
        }

        .qrder-sidebar-account .qrder-account-user-link:hover {
            background-color: rgba(255, 255, 255, 0.16);
            color: #ffffff !important;
        }

        .qrder-sidebar-account .qrder-logout-btn {
            width: 100%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.45rem;
            padding: 0.48rem 0.75rem;
            border-radius: var(--qrder-radius, 4px) !important;
            background-color: #a82330;
            border: 2px solid #f6efe6;
            color: #ffffff !important;
            font-size: 0.84rem;
            font-weight: 800;
            text-decoration: none !important;
            box-shadow: 2px 2px 0px #000000;
            transition: background-color 0.14s ease, transform 0.1s ease;
        }

        .qrder-sidebar-account .qrder-logout-btn:hover {
            background-color: #dc3545;
            color: #ffffff !important;
        }

        /* Branded full-screen loading curtain for form submissions & redirects */
        .qrder-loading-overlay {
            position: fixed;
            inset: 0;
            z-index: 2050;
            background-color: rgba(30, 19, 14, 0.62);
            backdrop-filter: blur(2px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }

        .qrder-loading-card {
            background-color: var(--qrder-surface, #fffdf9);
            color: var(--qrder-ink, #221610);
            border: 2px solid var(--qrder-border-strong, #2b1d16);
            border-radius: var(--qrder-radius, 4px);
            padding: 1.45rem 1.75rem;
            text-align: center;
            box-shadow: 6px 6px 0px #2b1d16;
            max-width: 290px;
            width: 100%;
        }

        .qrder-loading-pulse {
            animation: qrderPulse 1.1s ease-in-out infinite;
        }

        @@keyframes qrderPulse {
            0%, 100% { transform: scale(1); opacity: 1; }
            50% { transform: scale(0.92); opacity: 0.72; }
        }

        .qrder-social-icon-link {
            width: 40px;
            height: 40px;
            border-radius: var(--qrder-radius, 4px);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background-color: var(--qrder-surface);
            border: 2px solid var(--qrder-border-strong);
            color: var(--qrder-espresso);
            box-shadow: 2px 2px 0px var(--qrder-shadow-color);
            transition: transform 0.12s ease, background-color 0.14s ease, color 0.14s ease, box-shadow 0.12s ease;
        }

        .qrder-social-icon-link:hover {
            background-color: var(--qrder-roast);
            color: #fffaf3;
            transform: translate(-1px, -1px);
            box-shadow: 3px 3px 0px var(--qrder-shadow-color);
        }
    </style>
</head>
<body class="@bodyClass">
    <div id="qrderLoadingOverlay"
         class="qrder-loading-overlay d-none"
         role="status"
         aria-live="polite"
         aria-hidden="true">
        <div class="qrder-loading-card">
            <img src="~/images/qrder-logo.svg"
                 alt=""
                 width="44"
                 height="44"
                 class="qrder-loading-pulse mb-2" />
            <div class="fw-bold small" id="qrderLoadingText">Processing request...</div>
            <div class="text-muted fst-italic" style="font-size: 0.78rem;">Please wait a moment</div>
        </div>
    </div>

    @if (isStaff)
    {
        <div class="qrder-sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="qrder-pos-shell">
            <!-- Left Dark-Brown POS Sidebar (Desktop, Tablet Landscape & Slide-over on Mobile) -->
            <aside class="qrder-sidebar" id="qrderSidebar" aria-label="Workspace Navigation">
                <div class="qrder-sidebar-top">
                    <a class="qrder-brand-card" asp-controller="Home" asp-action="Index">
                        <img src="~/images/qrder-logo.svg" alt="QRDER Logo" class="qrder-brand-icon" />
                        <span class="qrder-brand-wordmark">QRDER</span>
                        <span class="qrder-brand-tag">ORDER SYSTEM</span>
                    </a>
                    <div class="qrder-pos-caption">POINT OF SALE</div>
                </div>

                <div class="qrder-sidebar-section-label">WORKSPACE</div>

                <nav class="qrder-sidebar-nav">
                    <a class="qrder-nav-item @(IsActive("Home", "Index") ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <span class="qrder-nav-icon" aria-hidden="true">&#9638;</span>
                        <span>Overview</span>
                    </a>

                    <a class="qrder-nav-item qrder-nav-item-featured @(IsActive("Orders", "CreateForCustomer") ? "active" : "")"
                       asp-controller="Orders" asp-action="CreateForCustomer">
                        <span class="qrder-featured-plus" aria-hidden="true">&#43;</span>
                        <span>New Order</span>
                    </a>

                    <a class="qrder-nav-item @(IsActive("Orders") && !IsActive("Orders", "CreateForCustomer") ? "active" : "")"
                       asp-controller="Orders" asp-action="Index">
                        <span class="qrder-nav-icon" aria-hidden="true">&#9719;</span>
                        <span>Order Board</span>
                    </a>

                    <a class="qrder-nav-item @(IsActive("Products") ? "active" : "")"
                       asp-controller="Products" asp-action="Index">
                        <span class="qrder-nav-icon" aria-hidden="true">&#9776;</span>
                        <span>Menu Studio</span>
                    </a>

                    <a class="qrder-nav-item @(IsActive("Customers") ? "active" : "")"
                       asp-controller="Customers" asp-action="Index">
                        <span class="qrder-nav-icon" aria-hidden="true">&#9787;</span>
                        <span>Customer Sessions</span>
                    </a>

                    <a class="qrder-nav-item @(IsActive("Reports") ? "active" : "")"
                       asp-controller="Reports" asp-action="Index">
                        <span class="qrder-nav-icon" aria-hidden="true">&#9636;</span>
                        <span>Sales Reports</span>
                    </a>

                    @if (isOwner)
                    {
                        <a class="qrder-nav-item @(IsActive("Employees") ? "active" : "")"
                           asp-controller="Employees" asp-action="Index">
                            <span class="qrder-nav-icon" aria-hidden="true">&#9881;</span>
                            <span>Staff Accounts</span>
                        </a>

                        <a class="qrder-nav-item @(IsActive("AuditLogs") ? "active" : "")"
                           asp-controller="AuditLogs" asp-action="Index">
                            <span class="qrder-nav-icon" aria-hidden="true">&#9745;</span>
                            <span>Audit Trail</span>
                        </a>
                    }

                    <a class="qrder-nav-item @(IsActive("Home", "BusinessDetails") ? "active" : "")"
                       asp-controller="Home" asp-action="BusinessDetails">
                        <span class="qrder-nav-icon" aria-hidden="true">&#9733;</span>
                        <span>Business Details</span>
                    </a>
                </nav>

                <div class="qrder-sidebar-footer">
                    <button type="button"
                            id="themeToggle"
                            class="btn btn-sm qrder-sidebar-theme-btn w-100 mb-2">
                        &#127769; Dark Mode
                    </button>

                    <div class="qrder-sidebar-account">
                        <partial name="_LoginPartial" />
                    </div>

                    <div class="qrder-branch-caption">
                        <span class="qrder-wordmark-inline">QRDER</span> &middot; Bean Crate Cafe
                    </div>
                </div>
            </aside>

            <div class="qrder-pos-main">
                @* Compact top bar shown only on mobile (< 768px) *@
                <header class="qrder-pos-topbar d-md-none">
                    <button type="button"
                            id="sidebarToggle"
                            class="btn btn-sm qrder-topbar-btn"
                            aria-label="Open workspace menu">
                        &#9776; Menu
                    </button>
                    <span class="qrder-wordmark-inline fw-bold">QRDER POS</span>
                    <span class="badge qrder-role-pill">@(isOwner ? "Owner" : "Staff")</span>
                </header>

                <main role="main" class="qrder-pos-content">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        @* Mobile-Priority, Tablet Landscape & PC-Adaptive Customer Shell (Always Light Mode) *@
        <header class="qrder-mobile-header sticky-top">
            <div class="qrder-mobile-container d-flex align-items-center justify-content-between gap-2">
                <a class="qrder-mobile-brand" asp-controller="Home" asp-action="Index">
                    <span class="qrder-mobile-logo-badge">
                        <img src="~/images/qrder-logo.svg"
                             alt="QRDER"
                             width="26"
                             height="26"
                             class="qrder-mobile-logo-icon" />
                    </span>
                    <span class="d-flex flex-column lh-1">
                        <span class="qrder-mobile-wordmark">QRDER</span>
                        <span class="qrder-mobile-sub">Bean Crate Cafe</span>
                    </span>
                </a>

                <div class="d-flex align-items-center gap-2">
                    <div class="qrder-mobile-login">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </header>

        <div class="qrder-mobile-container qrder-mobile-main">
            <main role="main" class="pb-4">
                @RenderBody()
            </main>

            <footer class="qrder-customer-footer text-center small text-muted py-3">
                <div class="mb-2">
                    <span class="fw-bold text-dark">Bean Crate Cafe</span> &middot; <span class="fst-italic">Antipolo City</span>
                </div>
                <div class="d-flex justify-content-center align-items-center gap-3">
                    <a href="https://www.facebook.com/beancrateofficial"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="qrder-social-icon-link text-decoration-none"
                       aria-label="Bean Crate Cafe on Facebook"
                       title="Facebook">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                            <path d="M13.5 22v-8.2h2.8l.4-3.2h-3.2V8.6c0-.9.3-1.6 1.6-1.6h1.7V4.1c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H7.5v3.2h2.7V22h3.3z" />
                        </svg>
                    </a>
                    <a href="https://www.instagram.com/beancrateph/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="qrder-social-icon-link text-decoration-none"
                       aria-label="Bean Crate Cafe on Instagram"
                       title="Instagram">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="2.5" y="2.5" width="19" height="19" rx="5" />
                            <circle cx="12" cy="12" r="4.2" />
                            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                        </svg>
                    </a>
                    <a href="https://www.tiktok.com/@@bean.crate"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="qrder-social-icon-link text-decoration-none"
                       aria-label="Bean Crate Cafe on TikTok"
                       title="TikTok">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                            <path d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 0 1-2.6 2.5 2.6 2.6 0 0 1-2.6-2.6 2.6 2.6 0 0 1 2.6-2.6c.3 0 .5 0 .8.1V9.6a5.8 5.8 0 0 0-.8-.1A5.7 5.7 0 0 0 4 15.3 5.7 5.7 0 0 0 9.8 21a5.7 5.7 0 0 0 5.7-5.7V9.1a7.4 7.4 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.2-1.6z" />
                        </svg>
                    </a>
                </div>
            </footer>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>