@model orderManagementSystem.Models.StaffEditViewModel
@{ ViewData["Title"] = "Edit Staff Account"; }
<h1>Edit Staff Account</h1>
<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Role"></label><select asp-for="Role" class="form-select"><option>Employee</option><option>Owner</option></select><span asp-validation-for="Role" class="text-danger"></span></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Account is active</label></div>
    <button class="btn btn-primary" type="submit">Save</button><a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
