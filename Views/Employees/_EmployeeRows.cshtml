@model IEnumerable<orderManagementSystem.Models.StaffRowViewModel>
@foreach (var item in Model)
{
    <tr>
        <td data-label="Name">@item.Name</td>
        <td data-label="Employee Code">@(string.IsNullOrWhiteSpace(item.EmployeeCode) ? "Not provided" : item.EmployeeCode)</td>
        <td data-label="Email">@item.Email</td>
        <td data-label="Role">@item.Role</td>
        <td data-label="Status">@(item.IsActive ? "Active" : "Deactivated")</td>
        <td data-label="Actions">
            <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
            <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
            <a asp-action="ResetPassword" asp-route-id="@item.Id">Reset password</a>
            @if (item.IsActive)
            {
                <form asp-action="Deactivate" asp-route-id="@item.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-link p-0">Deactivate</button>
                </form>
            }
        </td>
    </tr>
}
