@*
    Views/Reports/Index.cshtml
    PC & Tablet Landscape Sales Reports & VAT Breakdown for QRDER (Bean Crate Cafe):
    - Features Neo-Industrial financial telemetry strip and 4 Split-Flap KPI tiles.
    - Preset date filters (Today, Last 7 Days, This Month) + custom date picker.
    - Gross Sales, Net Sales, 12% VAT Collected, Cash vs. Online (Maya) breakdown.
    - Top-selling items table, detailed order ledger, CSV export, and
      15-column (A–O) batch clipboard copy for Project Encord / BIR Disb Excel workbooks.
*@
@model orderManagementSystem.Controllers.SalesReportViewModel

@{
    ViewData["Title"] = "Sales Reports";

    TimeZoneInfo ResolveManilaTimeZone()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Manila"); }
        catch
        {
            try { return TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time"); }
            catch { return TimeZoneInfo.CreateCustomTimeZone("PHT", TimeSpan.FromHours(8), "Philippine Standard Time", "PHT"); }
        }
    }

    var manilaTz = ResolveManilaTimeZone();
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    var validReportOrders = Model.Orders
        .Where(o => o.Status != "Cancelled")
        .OrderBy(o => o.OrderDate)
        .ToList();

    var encordBatchLines = validReportOrders.Select(o =>
    {
        var localDt = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(o.OrderDate, DateTimeKind.Utc),
            manilaTz
        );
        var gross = o.TotalAmount;
        var net = Math.Round(gross / 1.12m, 2, MidpointRounding.AwayFromZero);
        var vat = gross - net;

        return string.Join("\t", new[]
        {
            localDt.ToString("MM/dd/yyyy", inv),   // A: DATE
            "",                                    // B: CV#
            "BEAN CRATE CAFE",                     // C: PAYEE/SUPPLIERS NAME
            "Brgy. San Jose, Antipolo City",       // D: ADDRESS
            "",                                    // E: CHECK#
            "Meals",                               // F: PARTICULARS
            "VAT",                                 // G: BIR TYPE
            "000-000-000-000",                     // H: TIN OF SUPPLIER
            $"QRDER-{o.Id:D6}",                    // I: SI or OR #
            gross.ToString("0.00", inv),           // J: GROSS
            net.ToString("0.00", inv),             // K: NET OF VAT
            vat.ToString("0.00", inv),             // L: INPUT VAT
            "",                                    // M: NON-VAT
            "",                                    // N: NONE
            "OPS - MEALS AND LODGING"              // O: TYPE OF EXPENSE
        });
    });

    var encordBatchPayload = string.Join("\n", encordBatchLines);

    string StatusBadgeStyle(string status) => status switch
    {
        "Pending" => "background-color: #fff3cd; color: #664d03; border: 1.5px solid #664d03;",
        "Preparing" => "background-color: #cfe2ff; color: #084298; border: 1.5px solid #084298;",
        "Completed" => "background-color: #d1e7dd; color: #0f5132; border: 1.5px solid #0f5132;",
        "Cancelled" => "background-color: #f8d7da; color: #842029; border: 1.5px solid #842029;",
        _ => "background-color: var(--qrder-cream-soft); color: var(--qrder-ink); border: 1.5px solid var(--qrder-border-strong);"
    };
}

<div class="qrder-telemetry-strip mb-3">
    <div class="d-flex align-items-center gap-2">
        <span class="qrder-beacon" aria-hidden="true"></span>
        <span>FINANCIAL TELEMETRY &middot; SALES &amp; VAT LEDGER</span>
    </div>
    <div class="qrder-tabular">
        GROSS: ₱@Model.GrossSales.ToString("N2") &middot; ORDERS: @Model.TotalOrders &middot; PHT (UTC+8)
    </div>
</div>

<div class="d-flex flex-column flex-xl-row align-items-xl-end justify-content-between gap-3 mb-4">
    <div>
        <div class="qrder-eyebrow"><span class="qrder-wordmark-inline">QRDER</span> &middot; BEAN CRATE CAFE</div>
        <h1 class="qrder-page-title">Sales Reports</h1>
        <p class="qrder-page-subtitle mb-0">
            Showing financial and order summary for
            <strong>@Model.StartDate.ToString("MMM dd, yyyy")</strong>
            @if (Model.StartDate != Model.EndDate)
            {
                <span>to <strong>@Model.EndDate.ToString("MMM dd, yyyy")</strong></span>
            }
            (PHT).
        </p>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 flex-shrink-0">
        <a asp-action="ExportCsv"
           asp-route-range="@Model.Range"
           asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
           class="btn btn-sm menu-btn px-3 py-2 fw-bold text-nowrap">
            Export CSV Report
        </a>
        @if (validReportOrders.Any())
        {
            <button type="button"
                    id="copyEncordBatchBtn"
                    class="btn btn-sm btn-outline-secondary px-3 py-2 fw-bold text-nowrap">
                Copy Encord 15-Col Rows (@validReportOrders.Count)
            </button>
        }
        <a href="https://encord-bir-encoder2026-cyh5ffaghqhwhbht.eastasia-01.azurewebsites.net/"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-sm btn-outline-secondary px-3 py-2 fw-bold text-nowrap">
            Open Project Encord &#8599;
        </a>
        <span id="encordBatchCopyStatus" class="small fw-bold d-none text-nowrap" style="color: var(--qrder-roast);">
            Copied @validReportOrders.Count row(s) &#10003;
        </span>
    </div>
</div>

<textarea id="encordBatchPayloadBox" class="visually-hidden" readonly>@encordBatchPayload</textarea>

@* Date Range Filter Bar *@
<div class="qrder-card mb-4">
    <div class="d-flex flex-column flex-xl-row align-items-xl-end justify-content-between gap-3">
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index"
               asp-route-range="today"
               class="btn btn-sm @(Model.Range == "today" ? "menu-btn" : "btn-outline-secondary") px-3">
                Today
            </a>
            <a asp-action="Index"
               asp-route-range="week"
               class="btn btn-sm @(Model.Range == "week" ? "menu-btn" : "btn-outline-secondary") px-3">
                Last 7 Days
            </a>
            <a asp-action="Index"
               asp-route-range="month"
               class="btn btn-sm @(Model.Range == "month" ? "menu-btn" : "btn-outline-secondary") px-3">
                This Month
            </a>
        </div>

        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <input type="hidden" name="range" value="custom" />
            <div class="col-auto">
                <label for="startDate" class="form-label small text-muted fw-bold mb-1">From</label>
                <input type="date"
                       id="startDate"
                       name="startDate"
                       value="@Model.StartDate.ToString("yyyy-MM-dd")"
                       class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <label for="endDate" class="form-label small text-muted fw-bold mb-1">To</label>
                <input type="date"
                       id="endDate"
                       name="endDate"
                       value="@Model.EndDate.ToString("yyyy-MM-dd")"
                       class="form-control form-control-sm" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-outline-secondary px-3">
                    Apply Dates
                </button>
            </div>
        </form>
    </div>
</div>

@* Split-Flap KPI Summary Cards *@
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="qrder-flap-tile h-100 d-flex flex-column justify-content-between">
            <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 0.06em;">Gross Sales (VAT-Inc.)</div>
            <div class="fs-3 fw-bold qrder-tabular mt-1" style="color: var(--qrder-roast);">₱@Model.GrossSales.ToString("N2")</div>
            <div class="small text-muted qrder-tabular mt-1">@Model.TotalOrders active/completed order(s)</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="qrder-flap-tile h-100 d-flex flex-column justify-content-between">
            <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 0.06em;">Net Sales (Excl. VAT)</div>
            <div class="fs-3 fw-bold qrder-tabular mt-1">₱@Model.NetSales.ToString("N2")</div>
            <div class="small text-muted qrder-tabular mt-1">
                12% VAT: ₱@Model.VatAmount.ToString("N2") &middot;
                <a href="https://encord-bir-encoder2026-cyh5ffaghqhwhbht.eastasia-01.azurewebsites.net/"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="text-decoration-none fw-bold">
                    Encode &#8599;
                </a>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="qrder-flap-tile h-100 d-flex flex-column justify-content-between">
            <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 0.06em;">Cash vs. Online</div>
            <div class="fw-bold qrder-tabular mt-2">Cash: ₱@Model.CashSales.ToString("N2")</div>
            <div class="small text-muted qrder-tabular">Online (Maya): ₱@Model.CashlessSales.ToString("N2")</div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="qrder-flap-tile h-100 d-flex flex-column justify-content-between">
            <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 0.06em;">Order Fulfillment</div>
            <div class="fw-bold qrder-tabular mt-2">Completed: @Model.CompletedOrders</div>
            <div class="small text-muted qrder-tabular">Cancelled: @Model.CancelledOrders</div>
        </div>
    </div>
</div>

<div class="row g-4">
    @* Left: Top-Selling Items *@
    <div class="col-lg-5">
        <div class="qrder-card h-100">
            <h2 class="h5 fw-bold mb-3">Top-Selling Items</h2>
            @if (!Model.TopProducts.Any())
            {
                <p class="text-muted small mb-0">No non-cancelled items sold in this period.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th class="text-center">Qty</th>
                                <th class="text-end">Revenue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.TopProducts)
                            {
                                <tr>
                                    <td class="fw-bold">@item.ProductName</td>
                                    <td class="text-center fw-semibold qrder-tabular">@item.QuantitySold</td>
                                    <td class="text-end fw-bold qrder-tabular" style="color: var(--qrder-roast);">₱@item.Revenue.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* Right: Transaction Ledger *@
    <div class="col-lg-7">
        <div class="qrder-card h-100">
            <h2 class="h5 fw-bold mb-3">Order Ledger (@Model.Orders.Count)</h2>
            @if (!Model.Orders.Any())
            {
                <p class="text-muted small mb-0">No orders recorded during this date range.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle stack-table mb-0">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Time (PHT)</th>
                                <th>Customer</th>
                                <th>Method</th>
                                <th>Status</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.Orders)
                            {
                                var localDt = TimeZoneInfo.ConvertTimeFromUtc(
                                    DateTime.SpecifyKind(o.OrderDate, DateTimeKind.Utc),
                                    manilaTz
                                );
                                <tr>
                                    <td data-label="Order #" class="qrder-tabular">
                                        <a asp-controller="Orders"
                                           asp-action="Details"
                                           asp-route-id="@o.Id"
                                           class="fw-bold text-decoration-none">
                                            #@o.Id
                                        </a>
                                    </td>
                                    <td data-label="Time (PHT)" class="small qrder-tabular text-nowrap">@localDt.ToString("MMM dd, hh:mm tt")</td>
                                    <td data-label="Customer" class="fw-semibold">@o.CustomerName</td>
                                    <td data-label="Method" class="small">@o.PaymentMethod (@o.PaymentStatus)</td>
                                    <td data-label="Status">
                                        <span class="badge" style="@StatusBadgeStyle(o.Status)">
                                            @o.Status
                                        </span>
                                    </td>
                                    <td data-label="Total" class="text-end fw-bold qrder-tabular text-nowrap" style="color: var(--qrder-roast);">₱@o.TotalAmount.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const batchBtn = document.getElementById("copyEncordBatchBtn");
            const payloadBox = document.getElementById("encordBatchPayloadBox");
            const statusBadge = document.getElementById("encordBatchCopyStatus");

            function showBatchCopied() {
                if (!statusBadge) return;
                statusBadge.classList.remove("d-none");
                clearTimeout(statusBadge._t);
                statusBadge._t = setTimeout(() => statusBadge.classList.add("d-none"), 2600);
            }

            batchBtn?.addEventListener("click", async () => {
                if (!payloadBox) return;
                const text = payloadBox.value;

                try {
                    if (navigator.clipboard && window.isSecureContext) {
                        await navigator.clipboard.writeText(text);
                        showBatchCopied();
                        return;
                    }
                } catch {
                    // Fall back to execCommand below
                }

                payloadBox.classList.remove("visually-hidden");
                payloadBox.select();
                payloadBox.setSelectionRange(0, 999999);
                try {
                    document.execCommand("copy");
                    showBatchCopied();
                } finally {
                    payloadBox.classList.add("visually-hidden");
                }
            });
        })();
    </script>
}