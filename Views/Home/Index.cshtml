
@{
    ViewData["Title"] = "Home";
}

<style>
    .bean-hero {
        background: #3b2921;
        color: #fffaf2;
        border-radius: 18px;
        padding: 76px 48px;
    }

    .bean-hero h1 {
        font-size: clamp(2.5rem, 6vw, 4.5rem);
        font-weight: 750;
        letter-spacing: -2px;
    }

    .bean-hero p {
        color: #e7d8c8;
        max-width: 520px;
        font-size: 1.1rem;
    }

    .bean-btn {
        background: #d5a66b;
        color: #2e211b;
        border: none;
        font-weight: 600;
    }

    .bean-btn:hover {
        background: #e5bc8b;
        color: #2e211b;
    }

    .bean-category {
        background: #f6f0e8;
        border: 1px solid #eadfD2;
        border-radius: 14px;
        padding: 26px;
        height: 100%;
    }

    .bean-category h3 {
        color: #3b2921;
        font-weight: 700;
    }

    .bean-category p {
        color: #75675d;
    }

    .bean-section-title {
        color: #3b2921;
        font-weight: 750;
    }
</style>

<div class="container py-4">
    <section class="bean-hero mb-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <p class="text-uppercase fw-semibold mb-3">
                    Welcome to Bean Crate
                </p>
                <h1>Your coffee.<br />Your comfort.</h1>
                <p class="mt-3 mb-4">
                    Good drinks, satisfying meals, and a cozy place
                    to enjoy the little things.
                </p>
                <a asp-controller="Products"
                   asp-action="Index"
                   class="btn bean-btn btn-lg px-4">
                    Browse Our Menu
                </a>
            </div>
        </div>
    </section>

    <section class="mb-5">
        <div class="text-center mb-4">
            <h2 class="bean-section-title">Something for everyone</h2>
            <p class="text-muted">
                Explore what Bean Crate has to offer.
            </p>
        </div>

        <div class="row g-3">
            <div class="col-md-6 col-lg-3">
                <div class="bean-category">
                    <h3>Coffee</h3>
                    <p class="mb-0">Your everyday favorites and specialty coffee drinks.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="bean-category">
                    <h3>Non-Coffee</h3>
                    <p class="mb-0">Milk-based drinks, matcha, and refreshing choices.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="bean-category">
                    <h3>Meals & Snacks</h3>
                    <p class="mb-0">Something satisfying to go with your drink.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="bean-category">
                    <h3>Desserts</h3>
                    <p class="mb-0">A little something sweet to complete your visit.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="text-center py-4 mb-3">
        <h2 class="bean-section-title">Ready to order?</h2>
        <p class="text-muted">
            Browse the menu and find your next Bean Crate favorite.
        </p>
        <a asp-controller="Products"
           asp-action="Index"
           class="btn bean-btn px-4">
            Explore the Menu
        </a>
    </section>
</div>
