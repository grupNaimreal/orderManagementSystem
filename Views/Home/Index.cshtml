@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebEnv
@{
    ViewData["Title"] = "Overview";
    var isOwner = User.IsInRole("Owner");
    var isStaff = isOwner || User.IsInRole("Employee");

    string todayOrders = ViewBag.TodayOrdersCount?.ToString() ?? "—";
    string activeOrders = ViewBag.ActiveOrdersCount?.ToString() ?? "—";
    string pendingPayments = ViewBag.PendingPaymentsCount?.ToString() ?? "—";
    string todaySales = ViewBag.TodaySalesFormatted as string ?? "—";

    var hasCustomPngLogo = !string.IsNullOrWhiteSpace(WebEnv.WebRootPath)
        && System.IO.File.Exists(System.IO.Path.Combine(WebEnv.WebRootPath, "images", "qrder-logo.png"));
    var brandLogoPath = hasCustomPngLogo ? "~/images/qrder-logo.png" : "~/images/qrder-logo.svg";
}

<style>
    /* Neo-Industrial Dining Preference Segmented Toggle */
    .qrder-pref-group {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
    }

    .qrder-pref-group .qrder-pref-btn {
        border: 2px solid var(--qrder-border-strong, #2b1d16) !important;
        border-radius: var(--qrder-radius, 4px) !important;
        background-color: var(--qrder-surface, #fffdf9);
        color: var(--qrder-ink, #221610);
        font-weight: 700;
        padding: 0.45rem 0.65rem;
        box-shadow: 2px 2px 0px var(--qrder-shadow-color, #2b1d16);
        transition: background-color 0.14s ease, color 0.14s ease, transform 0.1s ease;
    }

    .qrder-pref-group .qrder-pref-btn.btn-sm {
        padding: 0.38rem 0.6rem;
        font-size: 0.84rem;
    }

    .qrder-pref-group .btn-check:checked + .qrder-pref-btn {
        background-color: var(--qrder-espresso, #2b1d16) !important;
        color: #fffaf3 !important;
        border-color: var(--qrder-border-strong, #2b1d16) !important;
        box-shadow: 3px 3px 0px var(--qrder-amber, #C05800);
    }

    /* Compact Zero-Scroll Customer Onboarding Card */
    .qrder-onboard-card {
        padding: 1rem 1.15rem;
    }

    .qrder-onboard-logo-box {
        width: 44px;
        height: 44px;
        background-color: var(--qrder-cream-soft);
        border: 2px solid var(--qrder-border-strong);
        border-radius: var(--qrder-radius, 4px);
        box-shadow: 2px 2px 0px var(--qrder-shadow-color);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        overflow: hidden;
    }

    .qrder-onboard-logo-box img {
        width: 32px;
        height: 32px;
        object-fit: contain;
    }

    @@media (min-width: 576px) {
        .qrder-onboard-card {
            padding: 1.45rem 1.75rem;
        }
    }
</style>

@if (isStaff)
{
    <div class="qrder-telemetry-strip mb-3">
        <div class="d-flex align-items-center gap-2">
            <span class="qrder-beacon" aria-hidden="true"></span>
            <span>POS COMMAND &middot; BEAN CRATE CAFE</span>
        </div>
        <div class="qrder-tabular">
            @(isOwner ? "OWNER CONSOLE" : "STAFF COUNTER") &middot; PHT (UTC+8)
        </div>
    </div>

    <div class="mb-4">
        <div class="qrder-eyebrow">WORKSPACE OVERVIEW</div>
        <h1 class="qrder-page-title">Overview</h1>
        <p class="qrder-page-subtitle mb-0">
            <span class="qrder-wordmark-inline">QRDER</span> counter operations, live queue status, and quick shortcuts.
        </p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6 col-lg-7">
            <div class="qrder-card h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h5 fw-bold mb-0">Counter Operations</h2>
                        <span class="badge" style="background-color: var(--qrder-cream-soft); color: var(--qrder-ink); border: 1.5px solid var(--qrder-border-strong);">
                            @(isOwner ? "Owner Access" : "Staff Access")
                        </span>
                    </div>
                    <p class="text-muted small mb-4">
                        Record walk-in orders, monitor incoming table QR orders, and update preparation status from one workspace.
                    </p>
                </div>

                <div>
                    <div class="d-grid d-sm-flex mb-2">
                        <a asp-controller="Orders"
                           asp-action="CreateForCustomer"
                           data-qrder-loading="Opening counter order builder..."
                           class="btn menu-btn px-4 py-2 fw-bold">
                            + New Order
                        </a>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="Orders"
                           asp-action="Index"
                           data-qrder-loading="Opening Order Board..."
                           class="btn btn-outline-secondary btn-sm px-3 py-2">
                            Order Board
                        </a>
                        <a asp-controller="Products"
                           asp-action="Index"
                           data-qrder-loading="Opening Menu Studio..."
                           class="btn btn-outline-secondary btn-sm px-3 py-2">
                            Menu Studio
                        </a>
                        <a asp-controller="Customers"
                           asp-action="Index"
                           data-qrder-loading="Opening Customer Sessions..."
                           class="btn btn-outline-secondary btn-sm px-3 py-2">
                            Customer Sessions
                        </a>
                        @if (isOwner)
                        {
                            <a asp-controller="Employees"
                               asp-action="Index"
                               data-qrder-loading="Opening Staff Accounts..."
                               class="btn btn-outline-secondary btn-sm px-3 py-2">
                                Staff Accounts
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-5">
            <div class="qrder-card h-100 d-flex flex-column">
                <h2 class="h5 fw-bold mb-3">Today&rsquo;s Snapshot</h2>
                <div class="row g-3 flex-grow-1">
                    <div class="col-6">
                        <div class="qrder-flap-tile h-100 d-flex flex-column justify-content-between">
                            <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 0.05em;">Orders Today</div>
                            <div class="fs-4 fw-bold qrder-tabular mt-1">@todayOrders</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="qrder-flap-tile h-100 d-flex flex-column justify-content-between">
                            <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 0.05em;">Active Queue</div>
                            <div class="fs-4 fw-bold qrder-tabular mt-1">@activeOrders</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="qrder-flap-tile h-100 d-flex flex-column justify-content-between">
                            <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 0.05em;">Unpaid / Pending</div>
                            <div class="fs-4 fw-bold qrder-tabular mt-1">@pendingPayments</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="qrder-flap-tile h-100 d-flex flex-column justify-content-between">
                            <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 0.05em;">Completed Sales</div>
                            <div class="fs-4 fw-bold qrder-tabular mt-1" style="color: var(--qrder-roast);">@todaySales</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="qrder-callout">
        <div class="fw-bold mb-1">
            Made for the <span class="qrder-wordmark-inline">QRDER</span> counter.
        </div>
        <div class="small text-muted fst-italic">
            A focused workspace for taking orders, confirming payment details, and keeping kitchen handoffs clear.
        </div>
    </div>
}
else
{
    var currentCustomer = ViewBag.CurrentCustomer as orderManagementSystem.Models.Customer;
    var tableLabel = (TempData["EnteredTable"] as string) ?? (ViewBag.TableLabel as string) ?? string.Empty;
    var enteredName = (TempData["EnteredName"] as string) ?? string.Empty;
    int myOrdersCount = ViewBag.MyOrdersCount is int count ? count : 0;

    <div class="mx-auto" style="max-width: 540px;">
        <div class="qrder-card qrder-onboard-card">
            <div class="d-flex align-items-center gap-2 gap-sm-3 mb-2">
                <div class="qrder-onboard-logo-box">
                    <img src="@brandLogoPath" asp-append-version="true" alt="QRDER Logo" />
                </div>
                <div class="min-w-0">
                    <div class="qrder-eyebrow mb-0" style="font-size: 0.66rem;">BEAN CRATE CAFE &middot; ORDER TICKET</div>
                    <h1 class="h4 fw-bold mb-0 lh-1">
                        <span class="qrder-wordmark-inline">QRDER</span>
                    </h1>
                    <p class="text-muted mb-0" style="font-size: 0.78rem; line-height: 1.25;">
                        Enter your table &amp; name to unlock the digital menu.
                    </p>
                </div>
            </div>

            <hr class="qrder-ticket-divider my-2" />

            @if (TempData["SessionNotice"] is string sessionNotice)
            {
                <div class="alert alert-info small py-1 px-2 mb-2">@sessionNotice</div>
            }

            @if (TempData["SessionError"] is string sessionError)
            {
                <div class="alert alert-danger small py-1 px-2 mb-2">@sessionError</div>
            }

            @if (currentCustomer != null)
            {
                var rawDisplay = currentCustomer.DisplayName ?? string.Empty;
                var separatorIdx = rawDisplay.IndexOf(" - ", StringComparison.Ordinal);
                var currentPrefix = separatorIdx > 0 ? rawDisplay[..separatorIdx].Trim() : string.Empty;
                var currentBaseName = separatorIdx > 0 ? rawDisplay[(separatorIdx + 3)..].Trim() : rawDisplay;
                var isTakeOut = currentPrefix.StartsWith("Take", StringComparison.OrdinalIgnoreCase);
                var currentTableNum = !isTakeOut && currentPrefix.StartsWith("Table ", StringComparison.OrdinalIgnoreCase)
                    ? currentPrefix[6..].Trim()
                    : (!isTakeOut && !string.Equals(currentPrefix, "Dine-In", StringComparison.OrdinalIgnoreCase)
                        ? currentPrefix
                        : string.Empty);

                <div class="qrder-callout py-2 px-3 mb-2">
                    <div class="d-flex align-items-center justify-content-between gap-2">
                        <div class="small text-muted fw-bold text-uppercase" style="letter-spacing: 0.08em; font-size: 0.7rem;">Active Session</div>
                        <span class="badge"
                              style="background-color: var(--qrder-espresso); color: #f6efe6; border: 1.5px solid var(--qrder-border-strong);">
                            @(isTakeOut ? "Take-Out" : "Dine-In")
                        </span>
                    </div>
                    <div class="fs-5 fw-bold mt-1">@currentCustomer.DisplayName</div>
                    <div class="text-muted fst-italic" style="font-size: 0.75rem;">
                        Active for 10 minutes between actions.
                    </div>
                </div>

                <div class="d-grid gap-2 mb-2">
                    <a asp-controller="Products"
                       asp-action="Index"
                       data-qrder-loading="Opening digital menu..."
                       class="btn menu-btn py-2 fw-bold">
                        Browse Menu &amp; Order
                    </a>
                    <a asp-controller="Orders"
                       asp-action="MyOrders"
                       data-qrder-loading="Loading your orders..."
                       class="btn btn-outline-secondary py-1">
                        View My Orders @(myOrdersCount > 0 ? $"({myOrdersCount})" : "")
                    </a>
                </div>

                <details class="p-2 mb-1" style="border: 2px solid var(--qrder-border-strong); border-radius: var(--qrder-radius, 4px); background-color: var(--qrder-cream-soft);">
                    <summary class="small fw-bold" style="cursor: pointer;">
                        Edit Name or Dine-In / Take-Out Preference
                    </summary>

                    <form asp-controller="Customers"
                          asp-action="UpdateMySession"
                          method="post"
                          class="pt-2">
                        <div class="mb-2">
                            <label class="form-label small fw-bold d-block mb-1">Dining Preference</label>
                            <div class="qrder-pref-group" role="group" aria-label="Dining preference">
                                <div>
                                    <input type="radio"
                                           class="btn-check"
                                           name="diningType"
                                           id="prefDineIn"
                                           value="DineIn"
                                           checked="@(!isTakeOut)" />
                                    <label class="btn btn-sm qrder-pref-btn w-100" for="prefDineIn">Dine-In</label>
                                </div>
                                <div>
                                    <input type="radio"
                                           class="btn-check"
                                           name="diningType"
                                           id="prefTakeOut"
                                           value="TakeOut"
                                           checked="@(isTakeOut)" />
                                    <label class="btn btn-sm qrder-pref-btn w-100" for="prefTakeOut">Take-Out</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-2 @(isTakeOut ? "d-none" : "")" id="editTableNumberGroup">
                            <label for="editTableNumber" class="form-label small fw-bold mb-1">
                                Table Number <span class="text-muted fw-normal fst-italic">(Optional)</span>
                            </label>
                            <input type="text"
                                   id="editTableNumber"
                                   name="tableNumber"
                                   value="@currentTableNum"
                                   maxlength="12"
                                   class="form-control form-control-sm"
                                   placeholder="e.g., 1 or Table 1" />
                        </div>

                        <div class="mb-2">
                            <label for="editDisplayName" class="form-label small fw-bold mb-1">Your Name</label>
                            <input type="text"
                                   id="editDisplayName"
                                   name="displayName"
                                   value="@currentBaseName"
                                   minlength="2"
                                   maxlength="30"
                                   required
                                   class="form-control form-control-sm" />
                        </div>

                        <button type="submit" class="btn btn-sm menu-btn w-100 fw-bold">
                            Save Session Changes
                        </button>
                    </form>
                </details>

                <form asp-controller="Customers"
                      asp-action="EndMySession"
                      method="post"
                      class="text-center">
                    <button type="submit" class="btn btn-link btn-sm text-muted text-decoration-none py-0">
                        End Current Session
                    </button>
                </form>

                <script>
                    (() => {
                        const dineInRadio = document.getElementById("prefDineIn");
                        const takeOutRadio = document.getElementById("prefTakeOut");
                        const tableGroup = document.getElementById("editTableNumberGroup");

                        function syncTableVisibility() {
                            if (!tableGroup) return;
                            tableGroup.classList.toggle("d-none", Boolean(takeOutRadio?.checked));
                        }

                        dineInRadio?.addEventListener("change", syncTableVisibility);
                        takeOutRadio?.addEventListener("change", syncTableVisibility);
                    })();
                </script>
            }
            else
            {
                var startIsTakeOut = tableLabel.StartsWith("Take", StringComparison.OrdinalIgnoreCase);
                var startTableNum = !startIsTakeOut && tableLabel.StartsWith("Table ", StringComparison.OrdinalIgnoreCase)
                    ? tableLabel[6..].Trim()
                    : (!startIsTakeOut && !string.Equals(tableLabel, "Dine-In", StringComparison.OrdinalIgnoreCase)
                        ? tableLabel
                        : string.Empty);

                <form asp-controller="Customers" asp-action="Create" method="post" id="startSessionForm" data-loading-text="Starting your table session...">
                    <input type="hidden" name="returnTo" value="home" />
                    <input type="hidden" id="tableLabel" name="tableLabel" value="@tableLabel" />

                    <div class="mb-2">
                        <label class="form-label fw-bold text-uppercase d-block mb-1" style="font-size: 0.72rem; letter-spacing: 0.06em;">
                            Dining Preference
                        </label>
                        <div class="qrder-pref-group" role="group" aria-label="Dining preference">
                            <div>
                                <input type="radio"
                                       class="btn-check"
                                       name="startDiningType"
                                       id="startPrefDineIn"
                                       value="DineIn"
                                       checked="@(!startIsTakeOut)" />
                                <label class="btn btn-sm qrder-pref-btn w-100" for="startPrefDineIn">Dine-In</label>
                            </div>
                            <div>
                                <input type="radio"
                                       class="btn-check"
                                       name="startDiningType"
                                       id="startPrefTakeOut"
                                       value="TakeOut"
                                       checked="@(startIsTakeOut)" />
                                <label class="btn btn-sm qrder-pref-btn w-100" for="startPrefTakeOut">Take-Out</label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-5 @(startIsTakeOut ? "d-none" : "")" id="startTableNumberGroup">
                            <label for="startTableNumber" class="form-label fw-bold text-uppercase mb-1" style="font-size: 0.72rem; letter-spacing: 0.06em;">
                                Table # <span class="text-muted fw-normal fst-italic" style="text-transform: none;">(Opt.)</span>
                            </label>
                            <input type="text"
                                   id="startTableNumber"
                                   value="@startTableNum"
                                   maxlength="12"
                                   class="form-control form-control-sm"
                                   placeholder="e.g., 1" />
                        </div>

                        <div class="@(startIsTakeOut ? "col-12" : "col-7")" id="startNameCol">
                            <label for="DisplayName" class="form-label fw-bold text-uppercase mb-1" style="font-size: 0.72rem; letter-spacing: 0.06em;">
                                Your Name
                            </label>
                            <input type="text"
                                   id="DisplayName"
                                   name="DisplayName"
                                   value="@enteredName"
                                   minlength="2"
                                   maxlength="30"
                                   required
                                   class="form-control form-control-sm"
                                   placeholder="e.g., Juan" />
                        </div>
                    </div>

                    <div class="d-grid mt-2">
                        <button type="submit" class="btn menu-btn py-2 fw-bold">
                            Start Session &amp; Open Menu
                        </button>
                    </div>
                </form>

                <script>
                    (() => {
                        const form = document.getElementById("startSessionForm");
                        const dineInRadio = document.getElementById("startPrefDineIn");
                        const takeOutRadio = document.getElementById("startPrefTakeOut");
                        const tableGroup = document.getElementById("startTableNumberGroup");
                        const nameCol = document.getElementById("startNameCol");
                        const tableInput = document.getElementById("startTableNumber");
                        const hiddenLabel = document.getElementById("tableLabel");

                        function syncStartSessionPreference() {
                            const isTakeOut = Boolean(takeOutRadio?.checked);
                            tableGroup?.classList.toggle("d-none", isTakeOut);
                            if (nameCol) {
                                nameCol.className = isTakeOut ? "col-12" : "col-7";
                            }

                            if (!hiddenLabel) return;
                            if (isTakeOut) {
                                hiddenLabel.value = "Take-Out";
                                return;
                            }

                            const rawTable = (tableInput?.value || "").trim();
                            if (!rawTable) {
                                hiddenLabel.value = "Dine-In";
                            } else if (/^(table|take)/i.test(rawTable)) {
                                hiddenLabel.value = rawTable;
                            } else {
                                hiddenLabel.value = `Table ${rawTable}`;
                            }
                        }

                        dineInRadio?.addEventListener("change", syncStartSessionPreference);
                        takeOutRadio?.addEventListener("change", syncStartSessionPreference);
                        tableInput?.addEventListener("input", syncStartSessionPreference);
                        form?.addEventListener("submit", syncStartSessionPreference);
                        syncStartSessionPreference();
                    })();
                </script>
            }
        </div>
    </div>
}