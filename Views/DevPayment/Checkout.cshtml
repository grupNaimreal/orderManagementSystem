@model orderManagementSystem.Models.Order

@{
    ViewData["Title"] = "Development Payment Simulator";
}

<div class="container py-4" style="max-width: 650px;">
    <div class="alert alert-warning">
        <strong>Development-only simulator</strong>
        <p class="mb-0">
            This is not PayMongo. No actual payment, charge, or transfer
            will occur.
        </p>
    </div>

    <div class="card">
        <div class="card-body">
            <h1 class="h3">Simulated Checkout</h1>
            <p class="text-muted">Bean Crate Order #@Model.Id</p>

            <hr />

            <div class="d-flex justify-content-between">
                <span>Customer</span>
                <strong>@Model.CustomerName</strong>
            </div>

            <div class="d-flex justify-content-between mt-2">
                <span>Order total</span>
                <strong>₱@Model.TotalAmount.ToString("N2")</strong>
            </div>

            <div class="d-flex justify-content-between mt-2">
                <span>Payment status</span>
                <strong>@Model.PaymentStatus</strong>
            </div>

            <hr />

            <form asp-controller="DevPayment"
                  asp-action="SimulatePaid"
                  asp-route-id="@Model.Id"
                  method="post" class="mb-2">
                <button type="submit" class="btn btn-success w-100">
                    Simulate Successful Payment
                </button>
            </form>

            <form asp-controller="DevPayment"
                  asp-action="SimulateFailed"
                  asp-route-id="@Model.Id"
                  method="post">
                <button type="submit" class="btn btn-outline-danger w-100">
                    Simulate Failed Payment
                </button>
            </form>

            <a asp-controller="Orders"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-link mt-3">
                Return to Order Details
            </a>
        </div>
    </div>
</div>
