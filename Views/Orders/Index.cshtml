@model IEnumerable<orderManagementSystem.Models.Order>

@{
    ViewData["Title"] = "Orders";
}

<h1>Orders</h1>

<p>
    <a asp-action="CreateForCustomer" class="btn btn-primary">
        Create Order for Customer
    </a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">No orders have been placed yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Order Date</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.CustomerName</td>
                        <td>@TimeZoneInfo.ConvertTimeFromUtc(
                            DateTime.SpecifyKind(order.OrderDate, DateTimeKind.Utc),
                            TimeZoneInfo.FindSystemTimeZoneById("Asia/Manila")
                        ).ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td>₱@order.TotalAmount.ToString("N2")</td>
                        <td>@order.Status</td>
                        <td>
                            <a asp-action="Details"
                               asp-route-id="@order.Id"
                               class="btn btn-sm btn-outline-primary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
