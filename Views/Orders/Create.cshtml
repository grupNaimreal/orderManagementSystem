@*
    Views/Orders/Create.cshtml
    Dual-mode Order Builder for QRDER (Bean Crate Cafe):
    - Staff Counter Mode (Model.IsStaffOrder == true):
      * Top Customer / Table Session selector + right-hand sticky Live Counter Ticket.
      * Same visual Category Picker -> 1:1 Product Cards -> Variant/Add-on Customizer
        flow used by customers, feeding directly into the live counter ticket.
    - Customer Mobile & Tablet Landscape Mode (Model.IsStaffOrder == false):
      * 2-column split checkout on Tablet Landscape & Desktop (md+):
        Left (col-md-7): Itemized order ticket cards with photos & overflow protection.
        Right (col-md-5): Sticky Payment & Checkout Ticket (Cash vs. Online Checkout via Maya,
        Chosen Payment banner, Estimated Total, and Submit actions).
*@
@using System.Text.Json
@model orderManagementSystem.Models.OrderCreateViewModel

@{
    ViewData["Title"] = Model.IsStaffOrder ? "New Counter Order" : "Place Order";
    var actionName = Model.IsStaffOrder ? "CreateForCustomer" : "Create";
    var savedItems = Model.Items.Select(i => new
    {
        i.ProductId,
        i.Quantity,
        i.VariantOptionId,
        AddOnOptionIds = i.AddOnOptionIds ?? new List<int>()
    });
    var productMeta = ViewBag.ProductMeta ?? new Dictionary<int, object>();
    var orderedCategories = orderManagementSystem.Data.MenuSeeder.OrderedCategoryNames;
}

<style>
    .min-w-0 {
        min-width: 0 !important;
    }

    .order-item.qrder-card {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
        overflow: hidden;
    }

    .qrder-order-thumb {
        position: relative;
        width: 80px;
        height: 80px;
        border-radius: var(--qrder-radius, 4px);
        overflow: hidden;
        flex-shrink: 0;
        background-color: var(--qrder-cream-soft);
        border: 2px solid var(--qrder-border-strong, #2b1d16);
    }

    @@media (max-width: 420px) {
        .qrder-order-thumb {
            width: 66px;
            height: 66px;
        }
    }

    .qrder-order-thumb img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .qrder-order-thumb-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.35rem;
        text-align: center;
        font-size: 0.68rem;
        font-weight: 700;
        line-height: 1.15;
        background: linear-gradient(135deg, #f3e5d8 0%, #e4ccb6 100%);
        color: #4A1C05;
        overflow-wrap: anywhere;
    }

    .item-header-name {
        display: block;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        overflow-wrap: break-word;
        word-break: normal;
        line-height: 1.25;
    }

    .item-readonly-summary {
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .qrder-pay-choice {
        border: 2px solid var(--qrder-border-strong, #2b1d16);
        border-radius: var(--qrder-radius, 4px);
        background-color: var(--qrder-surface);
        padding: 0.9rem 0.95rem;
        text-align: left;
        cursor: pointer;
        box-shadow: 3px 3px 0px var(--qrder-shadow-color, #2b1d16);
        transition: transform 0.12s ease, background-color 0.14s ease, box-shadow 0.12s ease;
        width: 100%;
        height: 100%;
    }

    .qrder-pay-choice:hover {
        transform: translate(-1px, -1px);
        box-shadow: 4px 4px 0px var(--qrder-shadow-color, #2b1d16);
    }

    .qrder-pay-choice.active {
        background-color: var(--qrder-cream-soft);
        border-color: var(--qrder-amber, #C05800);
        box-shadow: 4px 4px 0px var(--qrder-amber, #C05800);
    }

    .qrder-pay-selected-pill {
        background-color: var(--qrder-roast, #4A1C05);
        color: #fffaf3;
        border: 1.5px solid var(--qrder-border-strong, #2b1d16);
        font-size: 0.68rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    /* Staff Visual Menu Picker Cards (Roastery Press Editorial Style) */
    .staff-cat-card {
        border: 2px solid var(--qrder-border-strong, #2b1d16);
        border-radius: var(--qrder-radius, 4px);
        background: var(--qrder-surface);
        padding: 0.95rem 0.75rem;
        text-align: center;
        cursor: pointer;
        box-shadow: 3px 3px 0px var(--qrder-shadow-color, #2b1d16);
        transition: transform 0.12s ease, box-shadow 0.12s ease, background-color 0.14s ease;
        height: 100%;
    }

    .staff-cat-card:hover {
        transform: translate(-1px, -1px);
        background-color: var(--qrder-cream-soft);
        box-shadow: 4px 4px 0px var(--qrder-shadow-color, #2b1d16);
    }

    .staff-cat-icon {
        width: 44px;
        height: 44px;
        border-radius: var(--qrder-radius, 4px);
        background-color: var(--qrder-cream-soft);
        border: 1.5px solid var(--qrder-border-strong, #2b1d16);
        color: #4A1C05;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.5rem;
    }

    .staff-cat-icon svg {
        width: 24px;
        height: 24px;
    }

    .staff-prod-card {
        border: 2px solid var(--qrder-border-strong, #2b1d16);
        border-radius: var(--qrder-radius, 4px);
        background: var(--qrder-surface);
        overflow: hidden;
        cursor: pointer;
        text-align: left;
        box-shadow: 3px 3px 0px var(--qrder-shadow-color, #2b1d16);
        transition: transform 0.12s ease, box-shadow 0.12s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        padding: 0;
    }

    .staff-prod-card:hover {
        transform: translate(-1px, -1px);
        box-shadow: 4px 4px 0px var(--qrder-shadow-color, #2b1d16);
    }

    .staff-prod-square {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: var(--qrder-cream-soft);
        border-bottom: 2px solid var(--qrder-border-strong, #2b1d16);
    }

    .staff-prod-square img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .staff-prod-fallback {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        padding: 0.5rem;
        text-align: center;
        font-size: 0.75rem;
        font-weight: 700;
        line-height: 1.15;
    }

    .staff-modal-thumb {
        position: relative;
        width: 96px;
        height: 96px;
        border-radius: var(--qrder-radius, 4px);
        overflow: hidden;
        flex-shrink: 0;
        border: 2px solid var(--qrder-border-strong, #2b1d16);
        background: var(--qrder-cream-soft);
    }

    .staff-modal-thumb img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }
</style>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
    <div>
        <div class="qrder-eyebrow">
            <span class="qrder-wordmark-inline">QRDER</span> &middot; @(Model.IsStaffOrder ? "COUNTER POS" : "MOBILE ORDER")
        </div>
        <h1 class="qrder-page-title mb-1">
            @(Model.IsStaffOrder ? "New Order" : "Place Your Order")
        </h1>
        <p class="qrder-page-subtitle mb-0">
            @(Model.IsStaffOrder
                ? "Select a customer session, tap categories and items just like the customer menu, and submit to the queue."
                : "Review your chosen items, confirm your payment method, and submit to the counter.")
        </p>
    </div>

    @if (Model.IsStaffOrder)
    {
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="Customers"
               asp-action="Create"
               class="btn btn-outline-secondary btn-sm px-3">
                + New Customer Session
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                Order Board
            </a>
        </div>
    }
</div>

@if (Model.Products.Count == 0)
{
    <div class="alert alert-warning mb-4">
        There are currently no available products to order.
    </div>
}

<form asp-controller="Orders" asp-action="@actionName" method="post" id="qrderOrderForm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.IsStaffOrder)
    {
        <div class="row g-4">
            @* Staff Primary Column *@
            <div class="col-md-7 col-lg-8">
                <div class="qrder-card mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <label asp-for="CustomerId" class="form-label fw-bold mb-0">Customer / Table Session</label>
                        <a asp-controller="Customers" asp-action="Create" class="small fw-bold text-decoration-none">
                            Create new session &rarr;
                        </a>
                    </div>
                    <select asp-for="CustomerId" class="form-select" required>
                        <option value="">Select an active customer session...</option>
                        @foreach (var customer in Model.Customers)
                        {
                            <option value="@customer.Id">@customer.DisplayName</option>
                        }
                    </select>
                    <span asp-validation-for="CustomerId" class="text-danger small"></span>
                </div>

                @if (Model.Products.Count > 0)
                {
                    <div class="qrder-card mb-4" id="staffVisualMenuBrowser">
                        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-2 mb-3">
                            <div>
                                <div class="qrder-eyebrow">STEP 1 &middot; SELECT ITEMS</div>
                                <h2 class="h5 fw-bold mb-0">Browse Menu</h2>
                            </div>
                            <div style="min-width: 220px;">
                                <input type="search"
                                       id="staffMenuSearchInput"
                                       class="form-control form-control-sm"
                                       placeholder="Search drinks, meals, desserts..."
                                       aria-label="Search menu items" />
                            </div>
                        </div>

                        <div id="staffCategoryView">
                            <div class="small text-muted fw-bold text-uppercase mb-2" style="letter-spacing: 0.08em;">
                                Select a Category
                            </div>
                            <div class="row g-2" id="staffCategoryGrid"></div>
                        </div>

                        <div id="staffProductView" class="d-none">
                            <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
                                <button type="button" id="staffBackToCatsBtn" class="btn btn-sm btn-outline-secondary px-3">
                                    &larr; All Categories
                                </button>
                                <span class="fw-bold small" id="staffActiveCatLabel"></span>
                            </div>
                            <div class="row g-3" id="staffProductGrid"></div>
                        </div>
                    </div>
                }

                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h5 fw-bold mb-0">Current Order Items</h2>
                </div>

                <div id="order-items" class="mb-3"></div>

                <div id="staffEmptyItemsHint" class="qrder-callout text-center py-4 mb-3">
                    <div class="fw-bold mb-1">No items added yet</div>
                    <div class="small text-muted">
                        Choose a category above and tap any product card to customize and add it to this order.
                    </div>
                </div>
            </div>

            @* Staff Sticky Right Ticket *@
            <div class="col-md-5 col-lg-4">
                <div class="qrder-card sticky-top" style="top: 1.25rem;">
                    <div class="qrder-eyebrow">LIVE COUNTER TICKET</div>
                    <h2 class="h5 fw-bold mb-3">Order Summary</h2>

                    <div id="liveSummaryList" class="small mb-3">
                        <p class="text-muted mb-0">Select products on the left to build the order.</p>
                    </div>

                    <hr class="qrder-ticket-divider" />

                    <div class="mb-4">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Total Items</span>
                            <span id="liveItemCount" class="fw-bold">0</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold">Estimated Total</span>
                            <span class="fs-4 fw-bold" style="color: var(--qrder-roast);" id="liveOrderTotal">₱0.00</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit"
                                id="staffSubmitOrderBtn"
                                class="btn menu-btn py-2 fw-bold"
                                disabled="@(Model.Products.Count == 0)">
                            Submit Counter Order
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">
                            Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        var initialMethod = string.Equals(Model.PaymentMethod, "Maya", StringComparison.OrdinalIgnoreCase)
            ? "Maya"
            : "Cash";

        @* Customer Split Checkout: 2-Column on Tablet Landscape & Desktop (md+), Stacked on Mobile *@
        <div class="row g-4 align-items-start">
            @* Left Column (col-md-7): Itemized Order Ticket List *@
            <div class="col-12 col-md-7">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h2 class="h5 fw-bold mb-0">Order Items</h2>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-sm menu-btn px-3 fw-bold">
                        + Add More Items
                    </a>
                </div>

                <div id="order-items" class="mb-2"></div>

                <div id="customerEmptyItemsHint" class="qrder-callout text-center py-4 mb-3 d-none">
                    <div class="fw-bold mb-1">Your order is currently empty</div>
                    <div class="small text-muted mb-3">
                        Tap below to browse Bean Crate Cafe&rsquo;s menu and add items to your ticket.
                    </div>
                    <a asp-controller="Products" asp-action="Index" class="btn btn-sm menu-btn px-3 fw-bold">
                        + Add More Items
                    </a>
                </div>
            </div>

            @* Right Column (col-md-5): Sticky Payment & Checkout Ticket *@
            <div class="col-12 col-md-5">
                <div class="qrder-card sticky-top" style="top: 5.25rem;">
                    <input type="hidden" asp-for="PaymentMethod" id="customerPaymentMethod" value="@initialMethod" />

                    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                        <div>
                            <div class="qrder-eyebrow">CHECKOUT TICKET</div>
                            <h2 class="h5 fw-bold mb-0">Payment Method</h2>
                        </div>
                        <span class="small text-muted fst-italic">Tap to switch</span>
                    </div>

                    <div class="row g-2 mb-3" role="radiogroup" aria-label="Choose Payment Method">
                        <div class="col-12 col-sm-6 col-md-12">
                            <button type="button"
                                    class="qrder-pay-choice @(initialMethod == "Cash" ? "active" : "")"
                                    data-pay-option="Cash"
                                    aria-pressed="@(initialMethod == "Cash" ? "true" : "false")">
                                <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                    <span class="fw-bold">Cash at Counter</span>
                                    <span class="badge qrder-pay-selected-pill @(initialMethod == "Cash" ? "" : "d-none")"
                                          data-pay-badge="Cash">
                                        Selected
                                    </span>
                                </div>
                                <div class="small text-muted">
                                    Pay in cash at the Bean Crate counter after submitting.
                                </div>
                            </button>
                        </div>

                        <div class="col-12 col-sm-6 col-md-12">
                            <button type="button"
                                    class="qrder-pay-choice @(initialMethod == "Maya" ? "active" : "")"
                                    data-pay-option="Maya"
                                    aria-pressed="@(initialMethod == "Maya" ? "true" : "false")">
                                <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                    <span class="fw-bold">Online Checkout (via Maya)</span>
                                    <span class="badge qrder-pay-selected-pill @(initialMethod == "Maya" ? "" : "d-none")"
                                          data-pay-badge="Maya">
                                        Selected
                                    </span>
                                </div>
                                <div class="small text-muted">
                                    Pay online via QRPh, Maya Wallet, or Debit/Credit Card.
                                </div>
                            </button>
                        </div>
                    </div>

                    <div id="chosenPaymentBanner" class="qrder-callout py-2 px-3 mb-3">
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-1">
                            <span class="small text-muted">Chosen Method:</span>
                            <span class="fw-bold" id="chosenPaymentTitle">
                                @(initialMethod == "Maya" ? "Online Checkout (via Maya)" : "Cash at Counter")
                            </span>
                        </div>
                        <div class="small text-muted mt-1" id="chosenPaymentDescription">
                            @(initialMethod == "Maya"
                                ? "You will be redirected to Maya Sandbox Checkout right after submitting to complete your payment."
                                : "Your order will be sent to the counter. Please pay in cash at the register to start preparation.")
                        </div>
                    </div>

                    <span asp-validation-for="PaymentMethod" class="text-danger small d-block mb-2"></span>

                    <hr class="qrder-ticket-divider" />

                    <div class="mb-3">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Total Items</span>
                                <span id="customerLiveItemCount" class="fw-bold qrder-tabular">0</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Estimated Total</span>
                                <span class="fs-4 fw-bold qrder-tabular" style="color: var(--qrder-roast);" id="mobileLiveTotal">₱0.00</span>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit"
                                    id="customerSubmitOrderBtn"
                                    class="btn menu-btn py-2 fw-bold"
                                    disabled="@(Model.Products.Count == 0)">
                                Submit Cash Order
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
</form>

@* Staff Product Customization Modal (Matches Customer Product Details Flow) *@
@if (Model.IsStaffOrder)
{
    <div class="modal fade" id="staffCustomizeModal" tabindex="-1" aria-labelledby="staffModalProductName" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="background-color: var(--qrder-surface); color: var(--qrder-ink); border-radius: var(--qrder-radius, 4px); border: 2px solid var(--qrder-border-strong); box-shadow: 6px 6px 0px #2b1d16;">
                <div class="modal-header border-bottom">
                    <div class="d-flex align-items-center gap-3 min-w-0">
                        <div class="staff-modal-thumb">
                            <img id="staffModalImg" src="" alt="" class="d-none" />
                            <div id="staffModalFallback" class="qrder-order-thumb-fallback">Item</div>
                        </div>
                        <div class="min-w-0">
                            <span class="badge mb-1"
                                  id="staffModalCategory"
                                  style="background-color: var(--qrder-cream-soft); color: var(--qrder-ink); border: 1.5px solid var(--qrder-border-strong);">
                                Category
                            </span>
                            <h3 class="h5 fw-bold mb-0 text-break" id="staffModalProductName">Product</h3>
                            <div class="fw-bold mt-1" style="color: var(--qrder-roast);" id="staffModalLivePrice">₱0.00</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div id="staffModalVariantWrap" class="mb-3 d-none">
                        <label for="staffModalVariantSelect" class="form-label small fw-bold text-uppercase mb-1">
                            Choose Size / Variant
                        </label>
                        <select id="staffModalVariantSelect" class="form-select"></select>
                    </div>

                    <div id="staffModalAddOnsWrap" class="mb-3 d-none">
                        <div class="form-label small fw-bold text-uppercase mb-1">Optional Add-ons (Cheapest First)</div>
                        <div id="staffModalAddOnsList" class="p-2 d-flex flex-column gap-2" style="background-color: var(--qrder-cream-soft); border: 2px solid var(--qrder-border-strong); border-radius: var(--qrder-radius, 4px);"></div>
                    </div>

                    <div>
                        <label for="staffModalQtyInput" class="form-label small fw-bold text-uppercase mb-1">Quantity</label>
                        <div class="input-group" style="max-width: 175px;">
                            <button type="button" class="btn btn-outline-secondary" id="staffModalQtyMinus">&minus;</button>
                            <input type="number" id="staffModalQtyInput" class="form-control text-center fw-bold" value="1" min="1" max="99" />
                            <button type="button" class="btn btn-outline-secondary" id="staffModalQtyPlus">&#43;</button>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn menu-btn fw-bold px-4" id="staffModalConfirmAddBtn">
                        Add to Counter Order
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<template id="order-item-template">
    <div class="order-item qrder-card mb-3" data-order-row>
        <div class="d-flex align-items-start gap-2 gap-sm-3 min-w-0">
            @* Left Side: Corresponding Product Picture *@
            <div class="qrder-order-thumb">
                <img class="item-thumb-img d-none" src="" alt="" />
                <div class="qrder-order-thumb-fallback item-thumb-fallback">Select Item</div>
            </div>

            @* Right Side: Header + Read-Only Summary View + Collapsible Editor *@
            <div class="flex-grow-1 min-w-0">
                <div class="pb-2 mb-2 min-w-0" style="border-bottom: 2px dashed var(--qrder-border);">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span class="badge flex-shrink-0"
                              style="background-color: var(--qrder-cream-soft); color: var(--qrder-ink); border: 1.5px solid var(--qrder-border-strong);"
                              data-row-badge>
                            Item #1
                        </span>

                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <button type="button"
                                    class="btn btn-sm btn-outline-secondary toggle-edit-item">
                                Edit
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger remove-item">
                                Remove
                            </button>
                        </div>
                    </div>

                    <div class="fw-bold item-header-name mt-2">New Item</div>
                </div>

                @* Read-Only Summary View (Default when item is already chosen) *@
                <div class="item-readonly-summary">
                    <div class="small text-muted mb-1 item-summary-variant">Variant: Standard</div>
                    <div class="small text-muted mb-2 item-summary-addons">Add-ons: None</div>
                    <div class="d-flex justify-content-between align-items-center gap-2">
                        <span class="small fw-bold item-summary-qty">Qty: 1</span>
                        <span class="fw-bold fs-6 item-summary-subtotal" style="color: var(--qrder-roast);">₱0.00</span>
                    </div>
                </div>

                @* Editable Controls (Hidden unless "Edit" is clicked or item is brand-new) *@
                <div class="item-edit-panel d-none pt-1">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Choose Product</label>
                            <select class="form-select form-select-sm product-select"
                                    name="Items[__index__].ProductId"
                                    required>
                                <option value="">Select a product...</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Quantity</label>
                            <input type="number"
                                   class="form-control form-control-sm quantity-input"
                                   name="Items[__index__].Quantity"
                                   min="1"
                                   max="99"
                                   value="1"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Variant (Optional)</label>
                            <select class="form-select form-select-sm variant-select"
                                    name="Items[__index__].VariantOptionId">
                                <option value="">No variant</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Add-ons (Cheapest First)</label>
                            <div class="addons-container small">
                                <span class="text-muted">Choose a product first.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const products = @Html.Raw(JsonSerializer.Serialize(Model.Products));
        const productMeta = @Html.Raw(JsonSerializer.Serialize(productMeta));
        const orderedCategories = @Html.Raw(JsonSerializer.Serialize(orderedCategories));
        const savedItems = @Html.Raw(JsonSerializer.Serialize(savedItems));
        const isStaffOrder = @(Model.IsStaffOrder ? "true" : "false");

        const container = document.getElementById("order-items");
        const template = document.getElementById("order-item-template");
        const staffEmptyItemsHint = document.getElementById("staffEmptyItemsHint");
        const customerEmptyItemsHint = document.getElementById("customerEmptyItemsHint");

        const liveSummaryList = document.getElementById("liveSummaryList");
        const liveItemCount = document.getElementById("liveItemCount");
        const customerLiveItemCount = document.getElementById("customerLiveItemCount");
        const liveOrderTotal = document.getElementById("liveOrderTotal");
        const mobileLiveTotal = document.getElementById("mobileLiveTotal");
        const cartStorageKey = "qrder_customer_cart";

        let nextIndex = 0;

        function toProductSlug(name) {
            return String(name || "")
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, "-")
                .replace(/^-+|-+$/g, "");
        }

        function getMeta(product) {
            if (!product) return { CategoryName: "Other", ImageUrl: "" };
            const meta = productMeta[String(product.Id)] || productMeta[product.Id];
            return {
                CategoryName: (meta && meta.CategoryName) ? meta.CategoryName : "Other",
                ImageUrl: (meta && meta.ImageUrl) ? meta.ImageUrl : ("/images/products/" + toProductSlug(product.Name) + ".png")
            };
        }

        function resolveProductImage(product) {
            return getMeta(product).ImageUrl;
        }

        function getCategoryVisual(categoryName) {
            const key = String(categoryName || "").trim().toLowerCase();
            const map = {
                "coffee": { bg: "linear-gradient(135deg, #f3e5d8 0%, #e4ccb6 100%)", color: "#4A1C05", svg: "<path d='M5 9h11v5a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V9z'/><path d='M16 10h2a2 2 0 0 1 0 4h-2'/><path d='M8 4c0 1.5 1 2 1 3M12 4c0 1.5 1 2 1 3' stroke='#C05800'/>" },
                "non-coffee": { bg: "linear-gradient(135deg, #f7ece1 0%, #ead6c3 100%)", color: "#6B3A1E", svg: "<path d='M7 7h10l-1 13H8L7 7z'/><path d='M6 7h12'/><path d='M14 3l-2 4' stroke='#C05800'/><path d='M7.5 13h9' stroke='#C05800'/>" },
                "pasta": { bg: "linear-gradient(135deg, #fbe8d8 0%, #f3cfb3 100%)", color: "#8C3414", svg: "<path d='M4 13h16a8 8 0 0 1-16 0z'/><path d='M6 10c2-2 4 2 6 0s4 2 6 0' stroke='#C05800'/><path d='M5 6h14'/>" },
                "sandwiches": { bg: "linear-gradient(135deg, #f8ebd7 0%, #ecd3ae 100%)", color: "#704214", svg: "<path d='M4 10a8 5 0 0 1 16 0H4z'/><path d='M3 13h18' stroke='#C05800' stroke-width='2.2'/><path d='M5 16h14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z'/>" },
                "snacks": { bg: "linear-gradient(135deg, #fdf0d5 0%, #f5dc9f 100%)", color: "#7A4900", svg: "<path d='M6 10h12l-1.5 10h-9L6 10z'/><path d='M8 10V5M11 10V4M14 10V5M16 10V6' stroke='#C05800'/>" },
                "juices & lemonades": { bg: "linear-gradient(135deg, #fcf6d8 0%, #f4e69c 100%)", color: "#6E5800", svg: "<path d='M7 8h10l-1.2 12H8.2L7 8z'/><circle cx='16' cy='7' r='3.5' stroke='#C05800'/><path d='M10 4l1.5 4'/>" },
                "house blend": { bg: "linear-gradient(135deg, #f4e7d4 0%, #e5cda9 100%)", color: "#5C3A18", svg: "<path d='M7 6h9l-1 14H8L7 6z'/><path d='M16 9h2a2 2 0 0 1 0 5h-2'/><path d='M11 11c2-2 4 0 3 2s-3 2-3 0z' stroke='#C05800'/>" },
                "lemon soda": { bg: "linear-gradient(135deg, #e7f4f8 0%, #cde7f0 100%)", color: "#1D5B72", svg: "<path d='M7 7h10l-1 13H8L7 7z'/><circle cx='11' cy='12' r='1' fill='#C05800'/><circle cx='14' cy='15' r='1.2' fill='#C05800'/><path d='M15 3l-2 4' stroke='#C05800'/>" },
                "thai series & floats": { bg: "linear-gradient(135deg, #fae2cf 0%, #efc29e 100%)", color: "#8A3B08", svg: "<path d='M7 10h10l-1 10H8L7 10z'/><path d='M8 10a4 4 0 0 1 8 0' stroke='#C05800'/><path d='M15 4l-2 5' stroke='#C05800'/>" },
                "parfait series": { bg: "linear-gradient(135deg, #fae3e8 0%, #f1c5d0 100%)", color: "#7A223B", svg: "<path d='M7 9h10l-2 9H9L7 9z'/><path d='M9 20h6M12 18v2'/><path d='M8 9a4 3.5 0 0 1 8 0' stroke='#C05800'/><circle cx='12' cy='4.5' r='1.3' fill='#C05800'/>" },
                "specialty drinks": { bg: "linear-gradient(135deg, #f6e1e4 0%, #e7c2c8 100%)", color: "#6E2332", svg: "<path d='M7 9h10l-1 11H8L7 9z'/><path d='M6 7l3-3 3 2.5L15 4l3 3' stroke='#C05800'/>" },
                "desserts & banana pudding": { bg: "linear-gradient(135deg, #f8ebd6 0%, #ebd2a9 100%)", color: "#5E3814", svg: "<path d='M5 13h14l-1.5 6h-11L5 13z'/><path d='M7 13a5 4 0 0 1 10 0' stroke='#C05800'/><circle cx='12' cy='7.5' r='1.3' fill='#C05800'/>" },
                "buldak series": { bg: "linear-gradient(135deg, #fbe0dc 0%, #f2b8af 100%)", color: "#8F1D14", svg: "<path d='M4 12h16a8 7 0 0 1-16 0z'/><path d='M5 7l14-2M5 9l14-1' stroke='#C05800'/><path d='M12 15c1.5-1.5 1.5-3 0-4-1.5 1-1.5 2.5 0 4z' fill='#C05800'/>" },
                "matcha foam series": { bg: "linear-gradient(135deg, #e5efe0 0%, #c9dec0 100%)", color: "#2D5224", svg: "<path d='M7 7h10l-1 13H8L7 7z'/><path d='M7.3 10.5h9.4' stroke='#C05800' stroke-width='2.4'/><path d='M14 3l-1.5 4'/>" },
                "ube series": { bg: "linear-gradient(135deg, #ece3f5 0%, #d5c2ea 100%)", color: "#4B2673", svg: "<path d='M7 7h10l-1 13H8L7 7z'/><path d='M8 15c2-1.5 2 1.5 4 0s2 1.5 4 0' stroke='#C05800'/><path d='M14 3l-1.5 4'/>" },
                "pistachio series": { bg: "linear-gradient(135deg, #e9efe1 0%, #d1dec1 100%)", color: "#3F5723", svg: "<path d='M7 8h10l-1 12H8L7 8z'/><ellipse cx='12' cy='5' rx='3' ry='1.8' stroke='#C05800'/><path d='M7.4 11h9.2' stroke='#C05800'/>" },
                "rice bowls": { bg: "linear-gradient(135deg, #f6eadc 0%, #e7d1b8 100%)", color: "#5A3519", svg: "<path d='M4 12h16a8 7 0 0 1-16 0z'/><path d='M6 12a6 4 0 0 1 12 0' stroke='#C05800'/><path d='M8 20h8'/>" }
            };
            return map[key] || { bg: "linear-gradient(135deg, #f3e5d8 0%, #e4ccb6 100%)", color: "#4A1C05", svg: "<path d='M7 7h10l-1 13H8L7 7z'/><path d='M14 3l-2 4' stroke='#C05800'/>" };
        }

        function formatAdjustment(value) {
            const amount = Number(value);
            const sign = amount > 0 ? "+" : "";
            return sign + "₱" + amount.toFixed(2);
        }

        function addOption(select, id, name, adjustment, selected) {
            const option = document.createElement("option");
            option.value = String(id);
            option.textContent = name + " (" + formatAdjustment(adjustment) + ")";
            option.selected = selected;
            select.appendChild(option);
        }

        function setRowEditMode(row, isEditing) {
            const readonlyBox = row.querySelector(".item-readonly-summary");
            const editPanel = row.querySelector(".item-edit-panel");
            const toggleBtn = row.querySelector(".toggle-edit-item");

            row.dataset.editing = isEditing ? "true" : "false";
            readonlyBox?.classList.toggle("d-none", isEditing);
            editPanel?.classList.toggle("d-none", !isEditing);

            if (toggleBtn) {
                toggleBtn.textContent = isEditing ? "Done" : "Edit";
                toggleBtn.classList.toggle("menu-btn", isEditing);
                toggleBtn.classList.toggle("btn-outline-secondary", !isEditing);
            }
        }

        function updateRowDisplay(row, idx) {
            const badgeEl = row.querySelector("[data-row-badge]");
            if (badgeEl) {
                badgeEl.textContent = "Item #" + (idx + 1);
            }

            const productId = Number(row.querySelector(".product-select")?.value || 0);
            const product = products.find(p => p.Id === productId);

            const headerNameEl = row.querySelector(".item-header-name");
            const thumbImg = row.querySelector(".item-thumb-img");
            const thumbFallback = row.querySelector(".item-thumb-fallback");
            const summaryVariantEl = row.querySelector(".item-summary-variant");
            const summaryAddonsEl = row.querySelector(".item-summary-addons");
            const summaryQtyEl = row.querySelector(".item-summary-qty");
            const summarySubtotalEl = row.querySelector(".item-summary-subtotal");

            if (!product) {
                if (headerNameEl) headerNameEl.textContent = "Choose a Product";
                if (thumbFallback) {
                    thumbFallback.textContent = "No Item";
                    thumbFallback.classList.remove("d-none");
                }
                if (thumbImg) thumbImg.classList.add("d-none");
                if (summaryVariantEl) summaryVariantEl.textContent = "Variant: —";
                if (summaryAddonsEl) summaryAddonsEl.textContent = "Add-ons: —";
                if (summaryQtyEl) summaryQtyEl.textContent = "Qty: 1";
                if (summarySubtotalEl) summarySubtotalEl.textContent = "₱0.00";
                return null;
            }

            if (headerNameEl) {
                headerNameEl.textContent = product.Name;
            }

            const imgUrl = resolveProductImage(product);
            if (thumbFallback) {
                thumbFallback.textContent = product.Name;
            }
            if (thumbImg && thumbFallback) {
                if (thumbImg.getAttribute("data-loaded-src") !== imgUrl) {
                    thumbImg.setAttribute("data-loaded-src", imgUrl);
                    thumbImg.alt = product.Name;
                    thumbImg.onload = () => {
                        thumbImg.classList.remove("d-none");
                        thumbFallback.classList.add("d-none");
                    };
                    thumbImg.onerror = () => {
                        thumbImg.classList.add("d-none");
                        thumbFallback.classList.remove("d-none");
                    };
                    thumbImg.src = imgUrl;
                }
            }

            const qtyInput = row.querySelector(".quantity-input");
            const qty = Math.max(1, Math.min(99, Number(qtyInput?.value || 1)));

            let unitPrice = Number(product.BasePrice || 0);
            let variantLabel = "Standard";
            const optionNames = [];

            const variantVal = row.querySelector(".variant-select")?.value;
            const variantId = variantVal ? Number(variantVal) : null;
            if (variantId && variantId > 0) {
                const variant = (product.Variants || []).find(v => v.Id === variantId);
                if (variant) {
                    unitPrice += Number(variant.PriceAdjustment || 0);
                    variantLabel = variant.Name + " (" + formatAdjustment(variant.PriceAdjustment) + ")";
                    optionNames.push(variant.Name);
                }
            }

            const addOnIds = [];
            const addOnLabels = [];
            row.querySelectorAll(".addons-container input[type='checkbox']:checked").forEach(cb => {
                const addOnId = Number(cb.value);
                addOnIds.push(addOnId);
                const addOn = (product.AddOns || []).find(a => a.Id === addOnId);
                if (addOn) {
                    unitPrice += Number(addOn.PriceAdjustment || 0);
                    addOnLabels.push(addOn.Name + " (" + formatAdjustment(addOn.PriceAdjustment) + ")");
                    optionNames.push(addOn.Name);
                }
            });

            const lineTotal = unitPrice * qty;

            if (summaryVariantEl) {
                summaryVariantEl.textContent = "Variant: " + variantLabel;
            }
            if (summaryAddonsEl) {
                summaryAddonsEl.textContent = "Add-ons: " + (addOnLabels.length > 0 ? addOnLabels.join(", ") : "None");
            }
            if (summaryQtyEl) {
                summaryQtyEl.textContent = "Qty: " + qty;
            }
            if (summarySubtotalEl) {
                summarySubtotalEl.textContent = "₱" + lineTotal.toFixed(2);
            }

            return { product, qty, lineTotal, optionNames, variantId, addOnIds };
        }

        function updateOrderSummary() {
            const rows = container.querySelectorAll("[data-order-row]");
            let totalAmount = 0;
            let totalQty = 0;
            const summaryFragments = [];
            const syncedCustomerCart = [];

            if (staffEmptyItemsHint) {
                staffEmptyItemsHint.classList.toggle("d-none", rows.length > 0);
            }

            if (customerEmptyItemsHint) {
                customerEmptyItemsHint.classList.toggle("d-none", rows.length > 0);
            }

            rows.forEach((row, idx) => {
                const parsed = updateRowDisplay(row, idx);
                if (!parsed) {
                    return;
                }

                totalAmount += parsed.lineTotal;
                totalQty += parsed.qty;

                if (!isStaffOrder) {
                    syncedCustomerCart.push({
                        ProductId: parsed.product.Id,
                        Quantity: parsed.qty,
                        VariantOptionId: parsed.variantId,
                        AddOnOptionIds: parsed.addOnIds
                    });
                }

                const lineDiv = document.createElement("div");
                lineDiv.className = "mb-2 pb-2";
                lineDiv.style.borderBottom = "1px dashed var(--qrder-border)";

                const topRow = document.createElement("div");
                topRow.className = "d-flex justify-content-between gap-2 fw-bold";

                const nameSpan = document.createElement("span");
                nameSpan.className = "text-break";
                nameSpan.textContent = parsed.qty + " x " + parsed.product.Name;

                const priceSpan = document.createElement("span");
                priceSpan.className = "flex-shrink-0";
                priceSpan.textContent = "₱" + parsed.lineTotal.toFixed(2);

                topRow.append(nameSpan, priceSpan);
                lineDiv.appendChild(topRow);

                if (parsed.optionNames.length > 0) {
                    const optDiv = document.createElement("div");
                    optDiv.className = "text-muted fst-italic";
                    optDiv.textContent = parsed.optionNames.join(", ");
                    lineDiv.appendChild(optDiv);
                }

                summaryFragments.push(lineDiv);
            });

            if (!isStaffOrder) {
                try {
                    if (syncedCustomerCart.length > 0) {
                        sessionStorage.setItem(cartStorageKey, JSON.stringify(syncedCustomerCart));
                    } else {
                        sessionStorage.removeItem(cartStorageKey);
                    }
                } catch {
                    // Ignore storage quota issues
                }
            }

            const formattedTotal = "₱" + totalAmount.toFixed(2);
            const hasValidItems = totalQty > 0 && products.length > 0;

            const customerSubmit = document.getElementById("customerSubmitOrderBtn");
            const staffSubmit = document.getElementById("staffSubmitOrderBtn");
            if (customerSubmit) customerSubmit.disabled = !hasValidItems;
            if (staffSubmit) staffSubmit.disabled = !hasValidItems;

            if (liveSummaryList) {
                liveSummaryList.replaceChildren();
                if (summaryFragments.length === 0) {
                    const emptyP = document.createElement("p");
                    emptyP.className = "text-muted fst-italic mb-0";
                    emptyP.textContent = "Select products on the left to build the order.";
                    liveSummaryList.appendChild(emptyP);
                } else {
                    summaryFragments.forEach(frag => liveSummaryList.appendChild(frag));
                }
            }

            if (liveItemCount) {
                liveItemCount.textContent = String(totalQty);
            }

            if (customerLiveItemCount) {
                customerLiveItemCount.textContent = String(totalQty);
            }

            if (liveOrderTotal) {
                liveOrderTotal.textContent = formattedTotal;
            }

            if (mobileLiveTotal) {
                mobileLiveTotal.textContent = formattedTotal;
            }
        }

        function populateOptions(row, selectedVariant, selectedAddOns) {
            const productId = Number(row.querySelector(".product-select").value);
            const product = products.find(p => p.Id === productId);

            const variantSelect = row.querySelector(".variant-select");
            const addonsContainer = row.querySelector(".addons-container");

            variantSelect.replaceChildren();
            addonsContainer.replaceChildren();

            const noVariant = document.createElement("option");
            noVariant.value = "";
            noVariant.textContent = "No variant";
            variantSelect.appendChild(noVariant);

            if (!product) {
                addonsContainer.textContent = "Choose a product first.";
                return;
            }

            (product.Variants || []).forEach(variant => {
                addOption(
                    variantSelect,
                    variant.Id,
                    variant.Name,
                    variant.PriceAdjustment,
                    Number(selectedVariant) === variant.Id
                );
            });

            if (!product.AddOns || product.AddOns.length === 0) {
                addonsContainer.textContent = "No add-ons available.";
                return;
            }

            const sortedAddOns = [...product.AddOns].sort((a, b) =>
                (Number(a.PriceAdjustment) - Number(b.PriceAdjustment)) ||
                String(a.Name).localeCompare(String(b.Name))
            );

            sortedAddOns.forEach(addOn => {
                const wrapper = document.createElement("div");
                wrapper.className = "form-check";

                const input = document.createElement("input");
                input.type = "checkbox";
                input.className = "form-check-input";
                input.name = "Items[" + row.dataset.index + "].AddOnOptionIds";
                input.value = String(addOn.Id);
                input.id = "addon-" + row.dataset.index + "-" + addOn.Id;
                input.checked = selectedAddOns.includes(addOn.Id);
                input.addEventListener("change", updateOrderSummary);

                const label = document.createElement("label");
                label.className = "form-check-label";
                label.htmlFor = input.id;
                label.textContent =
                    addOn.Name + " (" + formatAdjustment(addOn.PriceAdjustment) + ")";

                wrapper.append(input, label);
                addonsContainer.appendChild(wrapper);
            });
        }

        function renumberRows() {
            const rows = container.querySelectorAll("[data-order-row]");

            rows.forEach((row, index) => {
                row.dataset.index = index;

                row.querySelectorAll("[name]").forEach(input => {
                    input.name = input.name.replace(
                        /Items\[\d+\]/g,
                        "Items[" + index + "]"
                    );
                });

                row.querySelectorAll(".addons-container input").forEach(input => {
                    input.id = input.id.replace(/addon-\d+-/, "addon-" + index + "-");
                });

                row.querySelectorAll(".addons-container label").forEach(label => {
                    label.htmlFor = label.htmlFor.replace(
                        /addon-\d+-/, "addon-" + index + "-"
                    );
                });
            });

            nextIndex = rows.length;
            updateOrderSummary();
        }

        function addRow(saved = {}, startInEditMode = false) {
            const fragment = template.content.cloneNode(true);
            const row = fragment.querySelector("[data-order-row]");
            const index = nextIndex++;

            row.dataset.index = index;

            row.querySelectorAll("[name]").forEach(input => {
                input.name = input.name.replaceAll("__index__", index);
            });

            const productSelect = row.querySelector(".product-select");
            const quantityInput = row.querySelector(".quantity-input");
            const variantSelect = row.querySelector(".variant-select");
            const toggleEditBtn = row.querySelector(".toggle-edit-item");

            products.forEach(product => {
                const option = document.createElement("option");
                option.value = String(product.Id);
                option.textContent =
                    product.Name + " — ₱" + Number(product.BasePrice).toFixed(2);
                productSelect.appendChild(option);
            });

            productSelect.value = saved.ProductId
                ? String(saved.ProductId)
                : "";

            quantityInput.value = saved.Quantity || 1;

            populateOptions(
                row,
                saved.VariantOptionId,
                (saved.AddOnOptionIds || []).map(Number)
            );

            const shouldEdit = startInEditMode || !saved.ProductId;
            setRowEditMode(row, shouldEdit);

            toggleEditBtn?.addEventListener("click", () => {
                const currentlyEditing = row.dataset.editing === "true";
                if (currentlyEditing) {
                    if (!productSelect.value) {
                        productSelect.focus();
                        return;
                    }
                    setRowEditMode(row, false);
                } else {
                    setRowEditMode(row, true);
                }
                updateOrderSummary();
            });

            productSelect.addEventListener("change", () => {
                populateOptions(row, null, []);
                updateOrderSummary();
            });

            quantityInput.addEventListener("input", updateOrderSummary);
            variantSelect.addEventListener("change", updateOrderSummary);

            row.querySelector(".remove-item").addEventListener("click", () => {
                row.remove();
                renumberRows();
            });

            container.appendChild(row);
            updateOrderSummary();
        }

        function addOrMergeStaffItem(productId, qty, variantId, addOnIds) {
            const normalizedVariant = variantId ? Number(variantId) : null;
            const normalizedAddOns = (addOnIds || []).map(Number).sort((a, b) => a - b);
            const rows = container.querySelectorAll("[data-order-row]");

            for (const row of rows) {
                const rowProdId = Number(row.querySelector(".product-select")?.value || 0);
                const rowVarVal = row.querySelector(".variant-select")?.value;
                const rowVarId = rowVarVal ? Number(rowVarVal) : null;
                const rowAddOns = Array.from(row.querySelectorAll(".addons-container input[type='checkbox']:checked"))
                    .map(cb => Number(cb.value))
                    .sort((a, b) => a - b);

                if (rowProdId === Number(productId)
                    && rowVarId === normalizedVariant
                    && JSON.stringify(rowAddOns) === JSON.stringify(normalizedAddOns)) {
                    const qtyInput = row.querySelector(".quantity-input");
                    const currentQty = Number(qtyInput?.value || 1);
                    if (qtyInput) {
                        qtyInput.value = String(Math.min(99, currentQty + Number(qty || 1)));
                    }
                    updateOrderSummary();
                    return;
                }
            }

            addRow({
                ProductId: Number(productId),
                Quantity: Number(qty || 1),
                VariantOptionId: normalizedVariant,
                AddOnOptionIds: normalizedAddOns
            }, false);
        }

        document.getElementById("add-item-top")?.addEventListener("click", () => addRow({}, true));

        // Staff Visual Menu Browser & Modal Customizer
        if (isStaffOrder && document.getElementById("staffVisualMenuBrowser")) {
            const catView = document.getElementById("staffCategoryView");
            const prodView = document.getElementById("staffProductView");
            const catGrid = document.getElementById("staffCategoryGrid");
            const prodGrid = document.getElementById("staffProductGrid");
            const activeCatLabel = document.getElementById("staffActiveCatLabel");
            const backToCatsBtn = document.getElementById("staffBackToCatsBtn");
            const staffSearchInput = document.getElementById("staffMenuSearchInput");

            const modalEl = document.getElementById("staffCustomizeModal");
            const bsModal = (modalEl && typeof bootstrap !== "undefined") ? new bootstrap.Modal(modalEl) : null;
            const modalImg = document.getElementById("staffModalImg");
            const modalFallback = document.getElementById("staffModalFallback");
            const modalCat = document.getElementById("staffModalCategory");
            const modalName = document.getElementById("staffModalProductName");
            const modalPrice = document.getElementById("staffModalLivePrice");
            const modalVarWrap = document.getElementById("staffModalVariantWrap");
            const modalVarSelect = document.getElementById("staffModalVariantSelect");
            const modalAddOnsWrap = document.getElementById("staffModalAddOnsWrap");
            const modalAddOnsList = document.getElementById("staffModalAddOnsList");
            const modalQtyInput = document.getElementById("staffModalQtyInput");
            const modalQtyMinus = document.getElementById("staffModalQtyMinus");
            const modalQtyPlus = document.getElementById("staffModalQtyPlus");
            const modalConfirmBtn = document.getElementById("staffModalConfirmAddBtn");

            let activeStaffCategory = null;
            let modalProduct = null;

            function updateModalPrice() {
                if (!modalProduct || !modalPrice) return;
                let unit = Number(modalProduct.BasePrice || 0);
                if (modalVarSelect && !modalVarWrap.classList.contains("d-none") && modalVarSelect.selectedOptions.length > 0) {
                    unit += Number(modalVarSelect.selectedOptions[0].dataset.adj || 0);
                }
                modalAddOnsList?.querySelectorAll("input[type='checkbox']:checked").forEach(cb => {
                    unit += Number(cb.dataset.adj || 0);
                });
                const q = Math.max(1, Math.min(99, Number(modalQtyInput?.value || 1)));
                modalPrice.textContent = "₱" + (unit * q).toFixed(2);
            }

            function openStaffProductCustomizer(product) {
                modalProduct = product;
                const meta = getMeta(product);
                const visual = getCategoryVisual(meta.CategoryName);

                if (modalCat) modalCat.textContent = meta.CategoryName;
                if (modalName) modalName.textContent = product.Name;

                if (modalFallback) {
                    modalFallback.textContent = product.Name;
                    modalFallback.style.background = visual.bg;
                    modalFallback.style.color = visual.color;
                    modalFallback.classList.remove("d-none");
                }
                if (modalImg) {
                    modalImg.classList.add("d-none");
                    modalImg.onload = () => {
                        modalImg.classList.remove("d-none");
                        modalFallback?.classList.add("d-none");
                    };
                    modalImg.onerror = () => {
                        modalImg.classList.add("d-none");
                        modalFallback?.classList.remove("d-none");
                    };
                    modalImg.src = meta.ImageUrl;
                }

                modalVarSelect.replaceChildren();
                const variants = product.Variants || [];
                if (variants.length > 0) {
                    modalVarWrap.classList.remove("d-none");
                    const stdOpt = document.createElement("option");
                    stdOpt.value = "";
                    stdOpt.dataset.adj = "0";
                    stdOpt.textContent = "Standard (+₱0.00)";
                    modalVarSelect.appendChild(stdOpt);

                    variants.forEach(v => {
                        const opt = document.createElement("option");
                        opt.value = String(v.Id);
                        opt.dataset.adj = String(v.PriceAdjustment || 0);
                        opt.textContent = v.Name + " (" + formatAdjustment(v.PriceAdjustment) + ")";
                        modalVarSelect.appendChild(opt);
                    });
                } else {
                    modalVarWrap.classList.add("d-none");
                }

                modalAddOnsList.replaceChildren();
                const addOns = [...(product.AddOns || [])].sort((a, b) =>
                    (Number(a.PriceAdjustment) - Number(b.PriceAdjustment)) ||
                    String(a.Name).localeCompare(String(b.Name))
                );
                if (addOns.length > 0) {
                    modalAddOnsWrap.classList.remove("d-none");
                    addOns.forEach(a => {
                        const rowDiv = document.createElement("div");
                        rowDiv.className = "form-check mb-0";
                        const cb = document.createElement("input");
                        cb.type = "checkbox";
                        cb.className = "form-check-input";
                        cb.value = String(a.Id);
                        cb.dataset.adj = String(a.PriceAdjustment || 0);
                        cb.id = "staffModalAddon_" + a.Id;
                        cb.addEventListener("change", updateModalPrice);

                        const lbl = document.createElement("label");
                        lbl.className = "form-check-label small";
                        lbl.htmlFor = cb.id;
                        lbl.textContent = a.Name + " (" + formatAdjustment(a.PriceAdjustment) + ")";

                        rowDiv.append(cb, lbl);
                        modalAddOnsList.appendChild(rowDiv);
                    });
                } else {
                    modalAddOnsWrap.classList.add("d-none");
                }

                if (modalQtyInput) modalQtyInput.value = "1";
                updateModalPrice();

                if (bsModal) {
                    bsModal.show();
                } else {
                    addOrMergeStaffItem(product.Id, 1, null, []);
                }
            }

            modalVarSelect?.addEventListener("change", updateModalPrice);
            modalQtyInput?.addEventListener("input", updateModalPrice);
            modalQtyMinus?.addEventListener("click", () => {
                const cur = Number(modalQtyInput?.value || 1);
                if (modalQtyInput) modalQtyInput.value = String(Math.max(1, cur - 1));
                updateModalPrice();
            });
            modalQtyPlus?.addEventListener("click", () => {
                const cur = Number(modalQtyInput?.value || 1);
                if (modalQtyInput) modalQtyInput.value = String(Math.min(99, cur + 1));
                updateModalPrice();
            });

            modalConfirmBtn?.addEventListener("click", () => {
                if (!modalProduct) return;
                const qty = Math.max(1, Math.min(99, Number(modalQtyInput?.value || 1)));
                const varId = (!modalVarWrap.classList.contains("d-none") && modalVarSelect?.value)
                    ? Number(modalVarSelect.value)
                    : null;
                const addOnIds = Array.from(modalAddOnsList?.querySelectorAll("input[type='checkbox']:checked") || [])
                    .map(cb => Number(cb.value));

                addOrMergeStaffItem(modalProduct.Id, qty, varId, addOnIds);
                bsModal?.hide();
            });

            function renderStaffProductCards(filteredProducts, headingText) {
                if (activeCatLabel) activeCatLabel.textContent = headingText;
                prodGrid.replaceChildren();

                if (filteredProducts.length === 0) {
                    const emptyCol = document.createElement("div");
                    emptyCol.className = "col-12 text-center text-muted small py-3";
                    emptyCol.textContent = "No matching items found.";
                    prodGrid.appendChild(emptyCol);
                } else {
                    filteredProducts.forEach(p => {
                        const meta = getMeta(p);
                        const visual = getCategoryVisual(meta.CategoryName);

                        const col = document.createElement("div");
                        col.className = "col-6 col-sm-4 col-md-4 col-lg-3";

                        const card = document.createElement("button");
                        card.type = "button";
                        card.className = "staff-prod-card w-100";

                        const square = document.createElement("div");
                        square.className = "staff-prod-square";

                        const img = document.createElement("img");
                        img.alt = p.Name;
                        img.loading = "lazy";

                        const fallback = document.createElement("div");
                        fallback.className = "staff-prod-fallback d-none";
                        fallback.style.background = visual.bg;
                        fallback.style.color = visual.color;
                        const fbSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                        fbSvg.setAttribute("viewBox", "0 0 24 24");
                        fbSvg.setAttribute("width", "32");
                        fbSvg.setAttribute("height", "32");
                        fbSvg.setAttribute("fill", "none");
                        fbSvg.setAttribute("stroke", "currentColor");
                        fbSvg.setAttribute("stroke-width", "1.8");
                        fbSvg.setAttribute("stroke-linecap", "round");
                        fbSvg.setAttribute("stroke-linejoin", "round");
                        fbSvg.innerHTML = visual.svg;

                        const fbLabel = document.createElement("span");
                        fbLabel.textContent = p.Name;
                        fallback.append(fbSvg, fbLabel);

                        img.onerror = () => {
                            img.classList.add("d-none");
                            fallback.classList.remove("d-none");
                        };
                        img.src = meta.ImageUrl;

                        square.append(img, fallback);

                        const body = document.createElement("div");
                        body.className = "p-2 d-flex flex-column flex-grow-1 w-100";

                        const title = document.createElement("div");
                        title.className = "fw-bold small text-dark mb-1 text-break";
                        title.style.lineHeight = "1.25";
                        title.textContent = p.Name;

                        const price = document.createElement("div");
                        price.className = "fw-bold small mt-auto";
                        price.style.color = "#4A1C05";
                        price.textContent = "₱" + Number(p.BasePrice).toFixed(2);

                        body.append(title, price);
                        card.append(square, body);
                        card.addEventListener("click", () => openStaffProductCustomizer(p));

                        col.appendChild(card);
                        prodGrid.appendChild(col);
                    });
                }

                catView.classList.add("d-none");
                prodView.classList.remove("d-none");
            }

            function renderStaffCategories() {
                activeStaffCategory = null;
                catGrid.replaceChildren();

                const grouped = new Map();
                products.forEach(p => {
                    const cat = getMeta(p).CategoryName;
                    if (!grouped.has(cat)) grouped.set(cat, []);
                    grouped.get(cat).push(p);
                });

                const sortedCatNames = Array.from(grouped.keys()).sort((a, b) => {
                    const idxA = orderedCategories.findIndex(c => c.toLowerCase() === a.toLowerCase());
                    const idxB = orderedCategories.findIndex(c => c.toLowerCase() === b.toLowerCase());
                    const rankA = idxA >= 0 ? idxA : 999;
                    const rankB = idxB >= 0 ? idxB : 999;
                    return rankA - rankB || a.localeCompare(b);
                });

                sortedCatNames.forEach(catName => {
                    const list = grouped.get(catName) || [];
                    const visual = getCategoryVisual(catName);

                    const col = document.createElement("div");
                    col.className = "col-6 col-sm-4 col-md-4 col-lg-3";

                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "staff-cat-card w-100";

                    const iconWrap = document.createElement("div");
                    iconWrap.className = "staff-cat-icon";
                    const catSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                    catSvg.setAttribute("viewBox", "0 0 24 24");
                    catSvg.setAttribute("fill", "none");
                    catSvg.setAttribute("stroke", "currentColor");
                    catSvg.setAttribute("stroke-width", "1.8");
                    catSvg.setAttribute("stroke-linecap", "round");
                    catSvg.setAttribute("stroke-linejoin", "round");
                    catSvg.innerHTML = visual.svg;
                    iconWrap.appendChild(catSvg);

                    const catTitle = document.createElement("div");
                    catTitle.className = "fw-bold small text-dark";
                    catTitle.style.lineHeight = "1.2";
                    catTitle.textContent = catName;

                    const catCount = document.createElement("div");
                    catCount.className = "text-muted mt-1";
                    catCount.style.fontSize = "0.74rem";
                    catCount.textContent = `${list.length} item(s)`;

                    btn.append(iconWrap, catTitle, catCount);

                    btn.addEventListener("click", () => {
                        activeStaffCategory = catName;
                        renderStaffProductCards(list, catName);
                    });

                    col.appendChild(btn);
                    catGrid.appendChild(col);
                });

                prodView.classList.add("d-none");
                catView.classList.remove("d-none");
            }

            backToCatsBtn?.addEventListener("click", () => {
                if (staffSearchInput) staffSearchInput.value = "";
                renderStaffCategories();
            });

            staffSearchInput?.addEventListener("input", () => {
                const term = staffSearchInput.value.trim().toLowerCase();
                if (!term) {
                    if (activeStaffCategory) {
                        const list = products.filter(p => getMeta(p).CategoryName === activeStaffCategory);
                        renderStaffProductCards(list, activeStaffCategory);
                    } else {
                        renderStaffCategories();
                    }
                    return;
                }

                const matches = products.filter(p =>
                    p.Name.toLowerCase().includes(term) ||
                    getMeta(p).CategoryName.toLowerCase().includes(term)
                );
                renderStaffProductCards(matches, `Search: "${staffSearchInput.value.trim()}"`);
            });

            renderStaffCategories();
        }

        // Visual Payment Method selector & Chosen Payment banner sync (Customer Mode)
        const paymentHiddenInput = document.getElementById("customerPaymentMethod");
        const paymentChoiceBtns = document.querySelectorAll("[data-pay-option]");
        const chosenPaymentTitle = document.getElementById("chosenPaymentTitle");
        const chosenPaymentDesc = document.getElementById("chosenPaymentDescription");
        const submitBtn = document.getElementById("customerSubmitOrderBtn");

        function selectPaymentMethod(method) {
            if (!paymentHiddenInput) return;
            const normalized = method === "Maya" ? "Maya" : "Cash";
            paymentHiddenInput.value = normalized;

            paymentChoiceBtns.forEach(btn => {
                const isSelected = btn.getAttribute("data-pay-option") === normalized;
                btn.classList.toggle("active", isSelected);
                btn.setAttribute("aria-pressed", isSelected ? "true" : "false");
            });

            document.querySelectorAll("[data-pay-badge]").forEach(badge => {
                const isSelected = badge.getAttribute("data-pay-badge") === normalized;
                badge.classList.toggle("d-none", !isSelected);
            });

            if (chosenPaymentTitle) {
                chosenPaymentTitle.textContent = normalized === "Maya"
                    ? "Online Checkout (via Maya)"
                    : "Cash at Counter";
            }

            if (chosenPaymentDesc) {
                chosenPaymentDesc.textContent = normalized === "Maya"
                    ? "You will be redirected to Maya Sandbox Checkout right after submitting to complete your payment."
                    : "Your order will be sent to the counter. Please pay in cash at the register to start preparation.";
            }

            if (submitBtn) {
                submitBtn.textContent = normalized === "Maya"
                    ? "Submit & Pay Online (Maya)"
                    : "Submit Cash Order";
            }
        }

        paymentChoiceBtns.forEach(btn => {
            btn.addEventListener("click", () => {
                selectPaymentMethod(btn.getAttribute("data-pay-option"));
            });
        });

        if (paymentHiddenInput) {
            selectPaymentMethod(paymentHiddenInput.value);
        }

        const hasServerItems = savedItems.length > 0 && savedItems.some(i => Number(i.ProductId) > 0);

        if (hasServerItems) {
            savedItems.forEach(item => addRow(item, false));
        } else if (!isStaffOrder) {
            let cartItems = [];
            try {
                const raw = sessionStorage.getItem(cartStorageKey);
                cartItems = raw ? JSON.parse(raw) : [];
            } catch {
                cartItems = [];
            }

            if (Array.isArray(cartItems) && cartItems.length > 0) {
                cartItems.forEach(item => addRow(item, false));
            } else {
                addRow({}, true);
            }
        } else {
            updateOrderSummary();
        }

        document.getElementById("qrderOrderForm")?.addEventListener("submit", () => {
            if (!isStaffOrder) {
                sessionStorage.removeItem(cartStorageKey);
            }
        });
    </script>
}