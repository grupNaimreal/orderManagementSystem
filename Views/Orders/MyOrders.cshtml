@model IEnumerable<orderManagementSystem.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<h1>My Orders</h1>

<p>
    <a asp-action="Create" class="btn btn-primary w-100 w-sm-auto">
        Place Another Order
    </a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">You haven't placed any orders yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped stack-table">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td data-label="Order #">#@order.Id</td>
                        <td data-label="Date">@order.OrderDate.ToLocalTime().ToString("MMM dd, yyyy hh:mm tt")</td>
                        <td data-label="Total">₱@order.TotalAmount.ToString("N2")</td>
                        <td data-label="Status">@order.Status</td>
                        <td data-label="Action">
                            <a asp-action="Details"
                               asp-route-id="@order.Id"
                               class="btn btn-sm btn-outline-primary">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
