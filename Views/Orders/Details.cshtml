</div>

@if (isStaff)
{
    <script>
        (() => {
            const copyBtn = document.getElementById("copyEncordFieldsBtn");
            const payloadEl = document.getElementById("encordRowPayload");
            const statusEl = document.getElementById("encordCopyStatus");

            function showCopiedBadge() {
                if (!statusEl) return;
                statusEl.classList.remove("d-none");
                clearTimeout(statusEl._t);
                statusEl._t = setTimeout(() => statusEl.classList.add("d-none"), 2400);
            }

            copyBtn?.addEventListener("click", async () => {
                if (!payloadEl) return;
                const text = payloadEl.value;

                try {
                    if (navigator.clipboard && window.isSecureContext) {
                        await navigator.clipboard.writeText(text);
                        showCopiedBadge();
                        return;
                    }
                } catch {
                    // Fall back to execCommand below
                }

                payloadEl.classList.remove("visually-hidden");
                payloadEl.select();
                payloadEl.setSelectionRange(0, 99999);
                try {
                    document.execCommand("copy");
                    showCopiedBadge();
                } finally {
                    payloadEl.classList.add("visually-hidden");
                }
            });
        })();
    </script>
}
else if (Model.Status == "Pending" || Model.Status == "Preparing")
{
    <script>
        (() => {
            const rootEl = document.getElementById("qrderOrderDetailsRoot");
            if (!rootEl) return;

            const currentOrderStatus = rootEl.getAttribute("data-order-status") || "";
            const paymentMethod = rootEl.getAttribute("data-payment-method") || "";
            const currentPaymentStatus = rootEl.getAttribute("data-payment-status") || "";
            const mayaCheckUrl = rootEl.getAttribute("data-maya-check-url") || "";
            const isPendingMaya = paymentMethod === "Maya"
                && currentPaymentStatus === "Pending"
                && currentOrderStatus === "Pending";

            async function checkOrderStatusUpdate() {
                if (document.hidden) return;
                try {
                    if (isPendingMaya && mayaCheckUrl) {
                        const mayaRes = await fetch(mayaCheckUrl, {
                            headers: { "X-Requested-With": "XMLHttpRequest" },
                            cache: "no-store"
                        });
                        if (mayaRes.ok) {
                            const data = await mayaRes.json();
                            if (data && data.reload) {
                                window.location.reload();
                                return;
                            }
                        }
                    }

                    const response = await fetch(window.location.href, {
                        headers: { "X-Requested-With": "XMLHttpRequest" },
                        cache: "no-store"
                    });
                    if (!response.ok) return;

                    const html = await response.text();
                    const doc = new DOMParser().parseFromString(html, "text/html");
                    const nextRoot = doc.getElementById("qrderOrderDetailsRoot");
                    if (!nextRoot) return;

                    const nextOrderStatus = nextRoot.getAttribute("data-order-status") || "";
                    const nextPaymentStatus = nextRoot.getAttribute("data-payment-status") || "";

                    if (nextOrderStatus !== currentOrderStatus || nextPaymentStatus !== currentPaymentStatus) {
                        window.location.reload();
                    }
                } catch {
                    // Ignore transient network errors and retry on next interval
                }
            }

            setInterval(checkOrderStatusUpdate, isPendingMaya ? 4000 : 8000);
        })();
    </script>
}