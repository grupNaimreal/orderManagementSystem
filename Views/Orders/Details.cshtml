@*
    Views/Orders/Details.cshtml
    Order Details & Printable Order Summary Slip for QRDER (Bean Crate Cafe):
    - Supports Cash and Maya Checkout Sandbox payment flows with automatic live Maya API polling.
    - Streamlines recovery options when a Maya session is cancelled/closed vs. actively open.
    - Guards "Start Preparing Order" until payment is confirmed so staff avoid error bounces.
    - Uses a cross-platform Asia/Manila timezone resolver safe on Windows, Linux, and containers.
*@
@model orderManagementSystem.Models.Order

@{
    ViewData["Title"] = $"Order #{Model.Id}";
    var isStaff = User.IsInRole("Owner") || User.IsInRole("Employee");

    TimeZoneInfo ResolveManilaTimeZone()
    {
        try { return TimeZoneInfo.FindSystemTimeZoneById("Asia/Manila"); }
        catch
        {
            try { return TimeZoneInfo.FindSystemTimeZoneById("Singapore Standard Time"); }
            catch { return TimeZoneInfo.CreateCustomTimeZone("PHT", TimeSpan.FromHours(8), "Philippine Standard Time", "PHT"); }
        }
    }

    var manilaTz = ResolveManilaTimeZone();
    var localOrderDate = TimeZoneInfo.ConvertTimeFromUtc(
        DateTime.SpecifyKind(Model.OrderDate, DateTimeKind.Utc),
        manilaTz
    );

    DateTime? localPaidDate = Model.PaymentPaidAtUtc.HasValue
        ? TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(Model.PaymentPaidAtUtc.Value, DateTimeKind.Utc),
            manilaTz)
        : null;

    string OrderStatusBadgeStyle(string status) => status switch
    {
        "Pending" => "background-color: #fff3cd; color: #664d03; border: 1.5px solid #664d03;",
        "Preparing" => "background-color: #cfe2ff; color: #084298; border: 1.5px solid #084298;",
        "Completed" => "background-color: #d1e7dd; color: #0f5132; border: 1.5px solid #0f5132;",
        "Cancelled" => "background-color: #f8d7da; color: #842029; border: 1.5px solid #842029;",
        _ => "background-color: var(--qrder-cream-soft); color: var(--qrder-ink); border: 1.5px solid var(--qrder-border-strong);"
    };

    string PaymentStatusBadgeStyle(string paymentStatus) => paymentStatus switch
    {
        "Paid" => "background-color: #d1e7dd; color: #0f5132; border: 1.5px solid #0f5132;",
        "Pending" => "background-color: #fff3cd; color: #664d03; border: 1.5px solid #664d03;",
        "Failed" or "Expired" => "background-color: #f8d7da; color: #842029; border: 1.5px solid #842029;",
        _ => "background-color: var(--qrder-cream-soft); color: var(--qrder-muted); border: 1.5px solid var(--qrder-border-strong);"
    };

    var canStartPreparing = Model.PaymentStatus == "Paid" || Model.PaymentStatus == "NotTracked";
    var isVerifyingMaya = string.Equals(TempData["PaymentVerifying"] as string, "true", StringComparison.OrdinalIgnoreCase);
    var showMayaRecoveryBox = !isStaff
        && Model.PaymentMethod == "Maya"
        && Model.PaymentStatus == "Pending"
        && Model.Status == "Pending";
    var hasOpenMayaUrl = !string.IsNullOrWhiteSpace(Model.PayMongoCheckoutUrl);
}

<style>
    .qrder-receipt-slip {
        background-color: var(--qrder-surface);
        border: 2px dashed var(--qrder-border-strong);
        border-radius: var(--qrder-radius, 4px);
        padding: 1.35rem;
        box-shadow: var(--qrder-shadow-md);
    }

    @@media print {
        body * {
            visibility: hidden !important;
        }

        #printableReceipt,
        #printableReceipt * {
            visibility: visible !important;
        }

        #printableReceipt {
            position: fixed;
            left: 0;
            top: 0;
            width: 100%;
            max-width: 360px;
            background: #ffffff !important;
            color: #000000 !important;
            border: none !important;
            padding: 12px !important;
            box-shadow: none !important;
        }

        .no-print {
            display: none !important;
        }
    }
</style>

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4 no-print">
    <div>
        <div class="qrder-eyebrow"><span class="qrder-wordmark-inline">QRDER</span> &middot; ORDER RECORD</div>
        <h1 class="qrder-page-title mb-0">Order #@Model.Id</h1>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @if (isStaff)
        {
            <button type="button" onclick="window.print()" class="btn btn-outline-secondary px-3">
                Print Order Slip
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary px-3">
                Back to Order Board
            </a>
        }
        else
        {
            <a asp-action="MyOrders" class="btn btn-outline-secondary px-3">
                Back to My Orders
            </a>
        }
    </div>
</div>

@if (!isStaff && Model.Status == "Completed")
{
    <div class="alert alert-success d-flex align-items-center gap-2 no-print" role="status">
        <span class="fs-5 lh-1">&#10003;</span>
        <div>
            <div class="fw-bold">Order Completed &mdash; Safe to Leave This Page</div>
            <div class="small">Your order is ready/served. You may now safely close or leave this page.</div>
        </div>
    </div>
}

@if (TempData["PaymentError"] is string paymentError)
{
    <div class="alert alert-warning no-print">@paymentError</div>
}

@if (TempData["PaymentNotice"] is string paymentNotice && !(showMayaRecoveryBox && !hasOpenMayaUrl))
{
    <div class="alert alert-info no-print">@paymentNotice</div>
}

@if (TempData["OrderNotice"] is string orderNotice)
{
    <div class="alert alert-info no-print">@orderNotice</div>
}

<div class="row g-4"
     id="qrderOrderDetailsRoot"
     data-order-id="@Model.Id"
     data-order-status="@Model.Status"
     data-payment-method="@Model.PaymentMethod"
     data-payment-status="@Model.PaymentStatus"
     data-maya-check-url="@Url.Action("CheckMayaStatus", "Orders", new { id = Model.Id })">
    @* Left / Primary Column: Order Metadata & Line Items *@
    <div class="@(isStaff ? "col-lg-8" : "col-12") no-print">
        <div class="qrder-card mb-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 pb-3 mb-3 border-bottom">
                <div>
                    <div class="small text-muted">Customer / Table Session</div>
                    <div class="fs-5 fw-bold">@Model.CustomerName</div>
                </div>
                <div class="text-md-end">
                    <div class="small text-muted">Placed (PHT)</div>
                    <div class="fw-semibold">@localOrderDate.ToString("MMM dd, yyyy hh:mm tt")</div>
                </div>
            </div>

            @if (!isStaff && (Model.Status == "Pending" || Model.Status == "Preparing"))
            {
                <div class="d-flex align-items-center justify-content-between gap-2 px-3 py-2 mb-3 small"
                     style="background-color: var(--qrder-cream-soft); border: 1.5px solid var(--qrder-border-strong); border-radius: var(--qrder-radius, 4px);">
                    <span class="fw-bold">
                        <span class="text-success me-1">&#9679;</span>
                        Live Order Tracking Active
                    </span>
                    <span class="text-muted fst-italic">Updates in real time</span>
                </div>
            }

            <div class="row g-3">
                <div class="col-sm-4">
                    <div class="qrder-callout">
                        <div class="small text-muted">Order Status</div>
                        <div class="mt-1">
                            <span class="badge" id="liveOrderStatusText" style="@OrderStatusBadgeStyle(Model.Status)">
                                @Model.Status
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="qrder-callout">
                        <div class="small text-muted">Payment Method</div>
                        <div class="fw-bold mt-1">@Model.PaymentMethod</div>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="qrder-callout">
                        <div class="small text-muted">Payment Status</div>
                        <div class="mt-1">
                            <span class="badge" id="livePaymentStatusText" style="@PaymentStatusBadgeStyle(Model.PaymentStatus)">
                                @Model.PaymentStatus
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            @if (showMayaRecoveryBox)
            {
                <div class="alert alert-info mt-4 mb-0">
                    @if (isVerifyingMaya)
                    {
                        <div class="d-flex align-items-center gap-2 fw-bold mb-1">
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Confirming Your Maya Payment...</span>
                        </div>
                        <p class="small mb-3">
                            Maya is finalizing your payment. This page checks automatically every few seconds, or you can tap <strong>Verify Payment Now</strong> below.
                        </p>
                    }
                    else if (hasOpenMayaUrl)
                    {
                        <div class="fw-bold mb-1">Complete Your Online Checkout (via Maya)</div>
                        <p class="small mb-3">
                            Complete your payment within 10 minutes of placing your order. If you already paid, tap <strong>Verify Payment Now</strong>.
                        </p>
                    }
                    else
                    {
                        <div class="fw-bold mb-1">Online Checkout Was Cancelled</div>
                        <p class="small mb-3">
                            Your previous Maya session was closed before payment. Start a new Maya session below or switch to <strong>Cash at Counter</strong>.
                        </p>
                    }

                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (hasOpenMayaUrl)
                        {
                            <a href="@Model.PayMongoCheckoutUrl"
                               onclick="window.showQrderLoading?.('Opening Maya Checkout...');"
                               class="btn btn-sm menu-btn fw-bold">
                                Open Maya Checkout &rarr;
                            </a>
                            <form asp-action="StartMayaCheckout" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    New Maya Session
                                </button>
                            </form>
                            <a asp-action="MayaReturn"
                               asp-route-id="@Model.Id"
                               asp-route-outcome="success"
                               onclick="window.showQrderLoading?.('Checking Maya payment status...');"
                               class="btn btn-sm btn-outline-success fw-bold">
                                &#10003; Verify Payment Now
                            </a>
                        }
                        else
                        {
                            <form asp-action="StartMayaCheckout" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm menu-btn fw-bold">
                                    Start New Maya Checkout &rarr;
                                </button>
                            </form>
                        }

                        <form asp-action="SwitchToCash" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary fw-bold">
                                Switch to Cash at Counter
                            </button>
                        </form>
                    </div>

                    <details class="small border-top pt-2">
                        <summary class="fw-bold" style="cursor: pointer;">
                            Maya Sandbox Test Credentials (For Demo / Grading)
                        </summary>
                        <div class="pt-2">
                            <div><strong>Test Mastercard (Instant Approval):</strong> <code>5123456789012346</code> &middot; Expiry <code>12/2030</code> &middot; CVV <code>111</code></div>
                            <div><strong>Test Visa Card (3DS):</strong> <code>4123450131001381</code> &middot; Expiry <code>12/2030</code> &middot; CVV <code>123</code> &middot; 3DS Password <code>mctest1</code></div>
                            <div><strong>Test Maya Wallet:</strong> <code>+639900100900</code> &middot; Password <code>Password@1</code> &middot; OTP <code>123456</code></div>
                            <div class="text-muted mt-1">
                                <strong>Note on QRPh in Sandbox:</strong> Maya&rsquo;s sandbox shows a QRPh preview without a simulated &ldquo;Pay&rdquo; button. Use <strong>Cards</strong> or <strong>Maya Wallet</strong> above for automatic confirmation, or ask counter staff to click <em>Confirm Maya / QRPh Manually</em>.
                            </div>
                        </div>
                    </details>
                </div>
            }

            @if (TempData["OrderError"] is string orderError)
            {
                <div class="alert alert-danger mt-3 mb-0">@orderError</div>
            }
        </div>

        @* Itemized Order Breakdown *@
        <div class="qrder-card">
            <h2 class="h5 fw-bold mb-3">Ordered Items (@Model.Items.Sum(i => i.Quantity))</h2>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@item.ProductNameSnapshot</div>
                                    @if (item.SelectedOptions != null && item.SelectedOptions.Any())
                                    {
                                        <div class="small text-muted">
                                            @string.Join(", ", item.SelectedOptions.Select(o =>
                                                $"{o.NameSnapshot} ({(o.PriceAdjustment >= 0 ? "+" : "")}₱{o.PriceAdjustment:N2})"))
                                        </div>
                                    }
                                </td>
                                <td class="text-center fw-bold">@item.Quantity</td>
                                <td class="text-end">₱@item.UnitPrice.ToString("N2")</td>
                                <td class="text-end fw-bold" style="color: var(--qrder-roast);">₱@item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Total Amount</td>
                            <td class="text-end fs-5 fw-bold" style="color: var(--qrder-roast);">₱@Model.TotalAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    @* Right Column: Staff Counter Actions & Order Summary Slip *@
    <div class="@(isStaff ? "col-lg-4" : "col-12")">
        @if (isStaff)
        {
            <div class="qrder-card mb-4 no-print">
                <div class="qrder-eyebrow">COUNTER CONTROLS</div>
                <h2 class="h5 fw-bold mb-3">Staff Actions</h2>

                @if (Model.PaymentMethod == "Cash" && Model.PaymentStatus == "Pending" && Model.Status != "Cancelled")
                {
                    <form asp-action="MarkCashPaid" asp-route-id="@Model.Id" method="post" class="mb-2">
                        <button type="submit" class="btn btn-success w-100 fw-bold">
                            &#10003; Confirm Cash Payment Received
                        </button>
                    </form>
                }

                @if (Model.PaymentMethod == "Maya" && Model.PaymentStatus == "Pending" && Model.Status != "Cancelled")
                {
                    <div class="d-grid gap-2 mb-2">
                        <form asp-action="VerifyMayaPayment" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn menu-btn w-100 fw-bold">
                                Verify Status with Maya
                            </button>
                        </form>
                        <form asp-action="MarkMayaPaid" asp-route-id="@Model.Id" method="post">
                            <button type="submit" class="btn btn-outline-success w-100 btn-sm">
                                Confirm Maya / QRPh Manually
                            </button>
                        </form>
                    </div>
                }

                @if (Model.Status == "Pending")
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="mb-2">
                        <input type="hidden" name="status" value="Preparing" />
                        <button type="submit"
                                class="btn btn-primary w-100 fw-bold"
                                disabled="@(!canStartPreparing)">
                            Start Preparing Order
                        </button>
                        @if (!canStartPreparing)
                        {
                            <div class="small text-muted text-center mt-1">
                                Confirm payment first before preparing.
                            </div>
                        }
                    </form>
                }

                @if (Model.Status == "Preparing")
                {
                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="mb-2">
                        <input type="hidden" name="status" value="Completed" />
                        <button type="submit" class="btn btn-success w-100 fw-bold">
                            Mark Order Completed
                        </button>
                    </form>
                }

                @if (Model.Status == "Pending" || Model.Status == "Preparing")
                {
                    <details class="border border-danger-subtle p-2 mt-2" style="border-radius: var(--qrder-radius, 4px);">
                        <summary class="small fw-bold text-danger px-1" style="cursor: pointer;">
                            Cancel Order with Reason
                        </summary>
                        <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="pt-2 px-1">
                            <input type="hidden" name="status" value="Cancelled" />

                            <div class="mb-2">
                                <label for="cancellationPreset" class="form-label small fw-bold mb-1">
                                    Reason
                                </label>
                                <select id="cancellationPreset"
                                        name="cancellationPreset"
                                        class="form-select form-select-sm">
                                    <option value="Customer requested cancellation">Customer requested cancellation</option>
                                    <option value="Unpaid / abandoned order">Unpaid / abandoned order</option>
                                    <option value="Item out of stock">Item out of stock</option>
                                    <option value="Duplicate / counter entry error">Duplicate / counter entry error</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>

                            <div class="mb-2">
                                <label for="cancellationReason" class="form-label small fw-bold mb-1">
                                    Additional Note <span class="text-muted fw-normal">(Optional)</span>
                                </label>
                                <input type="text"
                                       id="cancellationReason"
                                       name="cancellationReason"
                                       maxlength="180"
                                       class="form-control form-control-sm"
                                       placeholder="Enter brief details for audit log..." />
                            </div>

                            <button type="submit" class="btn btn-danger w-100 btn-sm fw-bold">
                                Confirm Order Cancellation
                            </button>
                        </form>
                    </details>
                }
            </div>
        }

        @* Non-BIR 80mm / 360px Thermal Order Summary Slip *@
        @{
            var vatableSales = Math.Round(Model.TotalAmount / 1.12m, 2, MidpointRounding.AwayFromZero);
            var vatAmount = Model.TotalAmount - vatableSales;
            var saleBanner = Model.PaymentMethod == "Maya"
                ? "** MAYA ONLINE PAYMENT **"
                : (Model.PaymentStatus == "NotTracked" ? "** COUNTER POS ORDER **" : "** CASH PAYMENT **");
            var channelLabel = Model.PaymentStatus == "NotTracked" ? "COUNTER POS" : "MOBILE QR ORDER";
            var encordParticulars = "Meals";
        }

        <div class="qrder-receipt-slip @(!isStaff ? "mx-auto" : "")"
             id="printableReceipt"
             style="font-size: 0.84rem; line-height: 1.38; max-width: @(isStaff ? "100%" : "380px");">
            <div class="text-center fw-bold" style="letter-spacing: 0.08em;">
                QRDER ORDER SUMMARY SLIP
            </div>
            <div class="text-center fw-bold mb-1" style="letter-spacing: 0.06em;">
                @saleBanner
            </div>

            <div class="text-center border-top border-bottom py-2 my-2">
                <div class="small text-uppercase">Queue / Order Number</div>
                <div class="fs-2 fw-bold lh-1 my-1">#@Model.Id</div>
                <div class="small fw-bold">@channelLabel</div>
            </div>

            <div class="text-center mb-2">
                <div class="fw-bold fs-6">BEAN CRATE CAFE</div>
                <div class="small">Sen. Lorenzo Sumulong Memorial Circle</div>
                <div class="small">Brgy. San Jose, Antipolo City</div>
                <div class="small">Tel: 0927 216 4623</div>
                <div class="small">Email: beancrateph@gmail.com</div>
            </div>

            <div class="border-top pt-2 mb-2 small">
                <div class="d-flex justify-content-between">
                    <span>Order Reference:</span>
                    <span class="fw-bold">QRDER-@Model.Id.ToString("D6")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Date (PHT):</span>
                    <span class="fw-bold">@localOrderDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Time (PHT):</span>
                    <span>@localOrderDate.ToString("hh:mm tt")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Customer / Table:</span>
                    <span class="fw-bold">@Model.CustomerName</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Order Status:</span>
                    <span class="fw-bold">@Model.Status</span>
                </div>
            </div>

            <div class="border-top border-bottom py-2 my-2">
                <table class="w-100" style="border-collapse: collapse; font-size: 0.78rem;">
                    <thead>
                        <tr class="border-bottom">
                            <th class="text-start pb-1" style="width: 12%;">QTY</th>
                            <th class="text-start pb-1" style="width: 46%;">ITEM</th>
                            <th class="text-end pb-1" style="width: 20%;">PRICE</th>
                            <th class="text-end pb-1" style="width: 22%;">TOTAL</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="align-top pt-1 fw-bold">@item.Quantity</td>
                                <td class="align-top pt-1 pe-1">
                                    <div class="fw-bold">@item.ProductNameSnapshot</div>
                                    @if (item.SelectedOptions != null && item.SelectedOptions.Any())
                                    {
                                        foreach (var opt in item.SelectedOptions)
                                        {
                                            <div style="font-size: 0.72rem; padding-left: 6px;">
                                                + @opt.NameSnapshot (@(opt.PriceAdjustment >= 0 ? "+" : "")@opt.PriceAdjustment.ToString("N2"))
                                            </div>
                                        }
                                    }
                                </td>
                                <td class="align-top text-end pt-1">@item.UnitPrice.ToString("N2")</td>
                                <td class="align-top text-end pt-1 fw-bold">@item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mb-2">
                <div class="d-flex justify-content-between fw-bold fs-6">
                    <span>TOTAL AMOUNT</span>
                    <span>₱@Model.TotalAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between small">
                    <span>Payment Method:</span>
                    <span>@Model.PaymentMethod (@Model.PaymentStatus)</span>
                </div>
                @if (localPaidDate.HasValue)
                {
                    <div class="d-flex justify-content-between small">
                        <span>Paid At (PHT):</span>
                        <span>@localPaidDate.Value.ToString("MMM dd, yyyy hh:mm tt")</span>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.PayMongoPaymentId))
                {
                    <div class="d-flex justify-content-between small">
                        <span>Online Txn Ref:</span>
                        <span>@Model.PayMongoPaymentId</span>
                    </div>
                }
            </div>

            <div class="border-top pt-2 text-center small">
                <div class="fw-bold">THANK YOU FOR VISITING BEAN CRATE!</div>
                <div>Follow us: @@beancrateph</div>
                <div class="mt-1 text-muted" style="font-size: 0.70rem;">
                    ORDER SUMMARY SLIP &middot; NOT AN OFFICIAL BIR RECEIPT
                </div>
            </div>
        </div>

        @if (isStaff)
        {
            var inv = System.Globalization.CultureInfo.InvariantCulture;
            var encordCopyLine = string.Join("\t", new[]
            {
                localOrderDate.ToString("MM/dd/yyyy", inv),   // A: DATE
                "",                                           // B: CV#
                "BEAN CRATE CAFE",                            // C: PAYEE/SUPPLIERS NAME
                "Brgy. San Jose, Antipolo City",              // D: ADDRESS
                "",                                           // E: CHECK#
                encordParticulars,                            // F: PARTICULARS
                "VAT",                                        // G: BIR TYPE
                "000-000-000-000",                            // H: TIN OF SUPPLIER
                $"QRDER-{Model.Id:D6}",                       // I: SI or OR #
                Model.TotalAmount.ToString("0.00", inv),      // J: GROSS
                vatableSales.ToString("0.00", inv),           // K: NET OF VAT
                vatAmount.ToString("0.00", inv),              // L: INPUT VAT
                "",                                           // M: NON-VAT
                "",                                           // N: NONE
                "OPS - MEALS AND LODGING"                     // O: TYPE OF EXPENSE
            });

            <div class="qrder-card mt-3 no-print">
                <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
                    <div>
                        <div class="qrder-eyebrow">BIR TAX WORKSPACE</div>
                        <h3 class="h6 fw-bold mb-0">Project Encord (15-Col Disb)</h3>
                    </div>
                    <a href="https://encord-bir-encoder2026-cyh5ffaghqhwhbht.eastasia-01.azurewebsites.net/"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-sm menu-btn px-3 fw-bold">
                        Open Encord &#8599;
                    </a>
                </div>
                <p class="text-muted small mb-2">
                    Scan the slip above with Encord&rsquo;s <strong>Vision AI</strong> or copy the exact <strong>15-column (A&ndash;O)</strong> tab-separated row (<code>Meals</code>, <code>VAT</code>, <code>OPS - MEALS AND LODGING</code>).
                </p>
                <textarea id="encordRowPayload" class="visually-hidden" readonly>@encordCopyLine</textarea>
