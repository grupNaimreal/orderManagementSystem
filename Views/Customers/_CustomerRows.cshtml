@*
    Views/Customers/_CustomerRows.cshtml
    Partial table rows for Customer Sessions (Views/Customers/Index.cshtml)
    and live AJAX search (CustomersController.Search).
    - Formats LastActivityUtc in Asia/Manila (PHT) to match the index header.
    - Displays status pills compatible with the Active / Ended / Expired filter tabs.
*@
@model IEnumerable<orderManagementSystem.Models.Customer>

@{
    var manilaTz = TimeZoneInfo.FindSystemTimeZoneById("Asia/Manila");
}

@if (!Model.Any())
{
    <tr>
        <td colspan="4" class="text-center text-muted small py-4">
            No customer sessions found.
        </td>
    </tr>
}
else
{
    @foreach (var item in Model)
    {
        var localActivity = TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(item.LastActivityUtc, DateTimeKind.Utc),
            manilaTz
        );

        <tr>
            <td data-label="Customer / Table" class="fw-semibold">
                @item.DisplayName
            </td>
            <td data-label="Session Status">
                @if (item.IsActive)
                {
                    <span class="badge rounded-pill"
                          style="background-color: #d1e7dd; color: #0f5132; border: 1px solid #badbcc;">
                        Active
                    </span>
                }
                else
                {
                    <span class="badge rounded-pill"
                          style="background-color: var(--qrder-cream-soft); color: var(--qrder-muted); border: 1px solid var(--qrder-border);">
                        Ended / Expired
                    </span>
                }
            </td>
            <td data-label="Last Activity (PHT)">
                <div>@localActivity.ToString("MMM dd, yyyy")</div>
                <div class="small text-muted">@localActivity.ToString("hh:mm tt")</div>
            </td>
            <td data-label="Actions" class="text-end">
                <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-secondary">
                        Details
                    </a>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-outline-secondary">
                        Edit
                    </a>
                    @if (item.IsActive)
                    {
                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-sm btn-outline-danger">
                            End Session
                        </a>
                    }
                </div>
            </td>
        </tr>
    }
}