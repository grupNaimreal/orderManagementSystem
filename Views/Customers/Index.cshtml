@model IEnumerable<orderManagementSystem.Models.Customer>
@{
    ViewData["Title"] = "Customer Accounts";
}
<h1>Customer Accounts</h1>
<p><a asp-action="Create" class="btn btn-primary w-100 w-sm-auto">Create Customer Session</a></p>
<div class="mb-3">
    <label for="customerSearch" class="form-label">Live search</label>
    <input id="customerSearch" class="form-control" type="search"
           placeholder="Search customer display names..."
           data-search-url="@Url.Action("Search")" />
</div>
<div class="table-responsive">
    <table class="table table-striped stack-table" id="customerTable">
        <thead><tr><th>Name</th><th>Session</th><th>Last Activity (UTC)</th><th>Actions</th></tr></thead>
        <tbody><partial name="_CustomerRows" model="Model" /></tbody>
    </table>
</div>
@section Scripts {
<script>
(() => {
    const input = document.getElementById("customerSearch");
    const body = document.querySelector("#customerTable tbody");
    let timer;
    let controller;
    input.addEventListener("input", () => {
        clearTimeout(timer);
        timer = setTimeout(async () => {
            controller?.abort();
            controller = new AbortController();
            try {
                const url = input.dataset.searchUrl + "?term=" + encodeURIComponent(input.value);
                const response = await fetch(url, { signal: controller.signal });
                if (response.ok) body.innerHTML = await response.text();
            } catch (error) {
                if (error.name !== "AbortError") console.error(error);
            }
        }, 250);
    });
})();
</script>
}
