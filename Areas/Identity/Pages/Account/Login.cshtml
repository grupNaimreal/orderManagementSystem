@page
@model orderManagementSystem.Areas.Identity.Pages.Account.LoginModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebEnv
@{
    ViewData["Title"] = "Admin & Staff Login";
    var hasCustomPngLogo = !string.IsNullOrWhiteSpace(WebEnv.WebRootPath)
        && System.IO.File.Exists(System.IO.Path.Combine(WebEnv.WebRootPath, "images", "qrder-logo.png"));
    var brandLogoPath = hasCustomPngLogo ? "~/images/qrder-logo.png" : "~/images/qrder-logo.svg";
}

<div class="mx-auto my-2 my-md-4" style="max-width: 460px;">
    <div class="qrder-telemetry-strip mb-3">
        <div class="d-flex align-items-center gap-2">
            <span class="qrder-beacon" aria-hidden="true"></span>
            <span>POS ACCESS GATE &middot; BEAN CRATE CAFE</span>
        </div>
        <span>STAFF ONLY</span>
    </div>

    <div class="qrder-card p-3 p-sm-4">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="d-inline-flex align-items-center justify-content-center p-2"
                 style="width: 52px; height: 52px; background-color: var(--qrder-cream-soft); border: 2px solid var(--qrder-border-strong); border-radius: var(--qrder-radius); box-shadow: 3px 3px 0px var(--qrder-shadow-color);">
                <img src="@brandLogoPath"
                     asp-append-version="true"
                     alt="QRDER Logo"
                     style="width: 36px; height: 36px; object-fit: contain;" />
            </div>
            <div>
                <div class="qrder-eyebrow mb-0">AUTHORIZED PERSONNEL</div>
                <h1 class="h4 fw-bold mb-0">Admin / Staff Login</h1>
                <div class="small text-muted">Sign in to manage orders, menu, and counter POS.</div>
            </div>
        </div>

        <hr class="qrder-ticket-divider my-3" />

        <form id="account" method="post" data-loading-text="Signing in to QRDER POS...">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label small fw-bold text-uppercase mb-1" style="letter-spacing: 0.06em;">
                    Staff Email
                </label>
                <input asp-for="Input.Email"
                       class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@beancrate.local" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label small fw-bold text-uppercase mb-1" style="letter-spacing: 0.06em;">
                    Password
                </label>
                <input asp-for="Input.Password"
                       class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="Enter your password" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="form-check mb-0">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label small fw-semibold" asp-for="Input.RememberMe">
                        Keep me signed in on this terminal
                    </label>
                </div>
            </div>

            <div class="d-grid mb-3">
                <button id="login-submit" type="submit" class="btn menu-btn py-2 fw-bold">
                    Sign In to POS Workspace &rarr;
                </button>
            </div>

            <div class="text-center border-top pt-2">
                <a asp-controller="Home" asp-action="Index" class="small fw-semibold text-decoration-none">
                    &larr; Return to Customer Ordering
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}